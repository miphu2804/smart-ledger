55555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="landing" target="cdl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=none;" edge="1" parent="1" source="cdb" target="pvb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6b" value="⑥ merge to staging" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pvb" target="stb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7b" value="⑦ release to main + approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stb" target="prb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5w" value="⑤ PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cdw" target="pvw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6w" value="⑥ merge to staging" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pvw" target="stw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7w" value="⑦ release to main + approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stw" target="prw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5l" value="⑤ PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cdl" target="pvl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6l" value="⑥ merge to staging" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pvl" target="stl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7l" value="⑦ release to main + approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stl" target="prl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="stt" value="&lt;b&gt;stt-model&lt;/b&gt;&lt;br&gt;speech/core.ts · stt-model.mjs&lt;br&gt;&lt;i&gt;fetch from HuggingFace, compare sizes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="690" y="50" width="170" height="70" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;CI result summary&lt;/b&gt; (job summary)&lt;br&gt;required gate: fails if changes,&lt;br&gt;ai, core, mobile-web, container-images&lt;br&gt;or stt-model failed / was cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e1;strokeColor=#d9534f;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="ci"><mxGeometry x="370" y="195" width="215" height="95" as="geometry" /></mxCell><mxCell id="eg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tests" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="and" value="Android release · mobile-release.yml — manual (workflow_dispatch), not part of ci.yml" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="1130" width="1660" height="180" as="geometry" /></mxCell><mxCell id="andn" value="Run by hand on an android-* environment. Every build resolves the speech model URL from R2 and bakes it in as EXPO_PUBLIC_STT_MODEL_URL.&lt;br&gt;Only android-production with publish=true holds the R2 token: it uploads missing model files under stt-model/&amp;lt;version&amp;gt;/ and the signed APK.&lt;br&gt;A staging build with a new model version only warns: voice input cannot download its model.&lt;br&gt;CI job stt-model runs the same fetch on the pull request, without R2." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="and"><mxGeometry x="30" y="50" width="640" height="130" as="geometry" /></mxCell><mxCell id="hf" value="&lt;b&gt;HuggingFace&lt;/b&gt;&lt;br&gt;pinned revision in stt-model.mjs&lt;br&gt;about 51 MB, 4 files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#1f2d3d;fontSize=12;dashed=1;" vertex="1" parent="and"><mxGeometry x="700" y="60" width="250" height="85" as="geometry" /></mxCell><mxCell id="mr" value="&lt;b&gt;mobile-release.yml&lt;/b&gt; · job android&lt;br&gt;resolve model URL → build&lt;br&gt;APK (publish) or AAB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="and"><mxGeometry x="1010" y="60" width="260" height="85" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;Cloudflare R2&lt;/b&gt; (public r2.dev)&lt;br&gt;stt-model/&amp;lt;version&amp;gt;/ · never rewritten&lt;br&gt;android/production/latest.apk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="and"><mxGeometry x="1340" y="60" width="310" height="85" as="geometry" /></mxCell><mxCell id="ehf" value="fetch (publish only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hf" target="mr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="er2" value="upload missing files + APK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mr" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>