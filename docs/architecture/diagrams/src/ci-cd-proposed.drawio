<mxfile host="app.diagrams.net"><diagram id="ci-cd-proposed" name="CI-CD proposed"><mxGraphModel background="#ffffff" dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="1330" as="geometry" /></mxCell><mxCell id="ci" value="CI · ci.yml (GitHub Actions) — pull request · push to staging / main · manual run" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1660" height="300" as="geometry" /></mxCell><mxCell id="dev" value="Developer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="ci"><mxGeometry x="50" y="90" width="36" height="64" as="geometry" /></mxCell><mxCell id="gh" value="GitHub repo&lt;br&gt;feat → staging → main" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," vertex="1" parent="ci"><mxGeometry x="185" y="94" width="56" height="56" as="geometry" /></mxCell><mxCell id="changes" value="&lt;b&gt;changes&lt;/b&gt;&lt;br&gt;path filter&lt;br&gt;git diff base..HEAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="ci"><mxGeometry x="370" y="82" width="170" height="80" as="geometry" /></mxCell><mxCell id="tests" value="Test jobs — each runs only when its path changed; a skipped job counts as passed" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f9ff;strokeColor=#5b8def;dashed=1;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;container=1;pointerEvents=0;" vertex="1" parent="ci"><mxGeometry x="620" y="40" width="1040" height="240" as="geometry" /></mxCell><mxCell id="ghaic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," vertex="1" parent="tests"><mxGeometry x="996" y="8" width="30" height="30" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;ai&lt;/b&gt;&lt;br&gt;backend/ai&lt;br&gt;supabase/migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="20" y="50" width="150" height="70" as="geometry" /></mxCell><mxCell id="core" value="&lt;b&gt;core&lt;/b&gt;&lt;br&gt;backend/core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="180" y="50" width="150" height="70" as="geometry" /></mxCell><mxCell id="images" value="&lt;b&gt;container-images&lt;/b&gt;&lt;br&gt;backend/* · compose.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="340" y="50" width="170" height="70" as="geometry" /></mxCell><mxCell id="mweb" value="&lt;b&gt;mobile-web&lt;/b&gt;&lt;br&gt;frontend/mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="520" y="50" width="160" height="70" as="geometry" /></mxCell><mxCell id="landing" value="&lt;b&gt;landing&lt;/b&gt;&lt;br&gt;frontend/web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="tests"><mxGeometry x="870" y="50" width="150" height="70" as="geometry" /></mxCell><mxCell id="cinote" value="Required checks: ai · core · mobile-web · container-images · CI result summary&lt;br&gt;PR: a new commit cancels the previous run · push: never cancelled&lt;br&gt;On failure: ai / core test reports (7 days)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="ci"><mxGeometry x="30" y="190" width="320" height="100" as="geometry" /></mxCell><mxCell id="cd" value="CD · called workflows (workflow_call, secrets: inherit) — same run, caller's branch and environment rules" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1660" height="200" as="geometry" /></mxCell><mxCell id="cdnote" value="A deploy runs only when its part changed and its test jobs did not fail.&lt;br&gt;Deploy concurrency is keyed by PR number, so the release PR from staging no longer cancels the staging deploy.&lt;br&gt;Manual run of ci.yml on staging / main: test and deploy everything." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="cd"><mxGeometry x="30" y="70" width="640" height="110" as="geometry" /></mxCell><mxCell id="cdb" value="&lt;b&gt;cd-backend.yml&lt;/b&gt; · job deploy&lt;br&gt;push / manual run · backend/ai or backend/core changed&lt;br&gt;CORS sync → ai → core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="cd"><mxGeometry x="700" y="70" width="330" height="90" as="geometry" /></mxCell><mxCell id="cdw" value="&lt;b&gt;cd-web.yml&lt;/b&gt; · job deploy-web&lt;br&gt;vercel build → deploy → alias&lt;br&gt;smoke: page · bundle · CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="cd"><mxGeometry x="1150" y="70" width="240" height="90" as="geometry" /></mxCell><mxCell id="cdl" value="&lt;b&gt;cd-landing.yml&lt;/b&gt; · job deploy-landing&lt;br&gt;vercel build → admin check&lt;br&gt;deploy → alias → smoke: page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="cd"><mxGeometry x="1410" y="70" width="240" height="90" as="geometry" /></mxCell><mxCell id="pv" value="Preview — pull request from a branch in this repository · no approval" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1660" height="170" as="geometry" /></mxCell><mxCell id="pvn" value="Trigger: pull_request&lt;br&gt;CI group ci-&amp;lt;PR&amp;gt; · changes base = PR base commit&lt;br&gt;Web and landing point at the staging backend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="pv"><mxGeometry x="30" y="55" width="640" height="100" as="geometry" /></mxCell><mxCell id="pvb" value="no backend deploy&lt;br&gt;on a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#1f2d3d;fontSize=12;dashed=1;" vertex="1" parent="pv"><mxGeometry x="700" y="55" width="330" height="85" as="geometry" /></mxCell><mxCell id="pvw" value="&lt;b&gt;vercel-preview&lt;/b&gt;&lt;br&gt;smart-ledger-preview-0N.vercel.app&lt;br&gt;+ PR comment with the URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="pv"><mxGeometry x="1150" y="55" width="240" height="85" as="geometry" /></mxCell><mxCell id="pvl" value="&lt;b&gt;landing-preview&lt;/b&gt;&lt;br&gt;smart-ledger-landing-pr-N&lt;br&gt;.vercel.app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="pv"><mxGeometry x="1410" y="55" width="240" height="85" as="geometry" /></mxCell><mxCell id="st" value="Staging — push to staging (squash merge) · branch policy staging · no approval" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1660" height="170" as="geometry" /></mxCell><mxCell id="stn" value="Trigger: push to staging&lt;br&gt;CI group ci-&amp;lt;sha&amp;gt; · changes base = previous commit of staging" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;" vertex="1" parent="st"><mxGeometry x="30" y="55" width="640" height="100" as="geometry" /></mxCell><mxCell id="stb" value="&lt;b&gt;railway-staging&lt;/b&gt;&lt;br&gt;Railway services ai + core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="st"><mxGeometry x="700" y="55" width="330" height="85" as="geometry" /></mxCell><mxCell id="stw" value="&lt;b&gt;vercel-staging&lt;/b&gt;&lt;br&gt;smart-ledger-staging.vercel.app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" vertex="1" parent="st"><mxGeometry x="1150" y="55" width="240" height="85" as="geometry" /></mxCell><mxCell id="stl" value="&lt;b&gt;landing-staging&lt;/b&gt;&lt;br&gt;smart-ledger-landing-staging&lt;br&gt;.vercel.app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;