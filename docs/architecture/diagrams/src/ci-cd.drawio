<mxfile host="drawio">
  <diagram id="cicd" name="CI/CD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="SmartLedger CI/CD on GitHub Actions" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1f2d3d;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Triggers column -->
        <mxCell id="t-pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;opened or updated" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t-push" value="&lt;b&gt;Push or merge&lt;/b&gt;&lt;br&gt;to staging or main" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t-cd" value="&lt;b&gt;Person: Run workflow&lt;/b&gt;&lt;br&gt;CD, redeploy" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="20" y="512" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t-prev" value="&lt;b&gt;Person: Run workflow&lt;/b&gt;&lt;br&gt;Preview, PR number" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- CI band -->
        <mxCell id="band-ci" value="CI: ci.yml (tests on every pull request and push)" style="rounded=1;arcSize=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#f7faff;strokeColor=#5b8def;fontStyle=1;fontSize=14;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="1140" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="ci-runner" value="Select runner&lt;br&gt;&lt;i&gt;GitHub-hosted or self-hosted&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="230" y="165" width="170" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="changes" value="Detect changes&lt;br&gt;&lt;i&gt;which parts changed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="440" y="165" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="grp-test" value="Test and build (in parallel, only changed parts)" style="rounded=1;arcSize=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#ffffff;strokeColor=#5b8def;fontSize=12;fontStyle=1;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="330" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="j-ai" value="AI service: Python tests ✱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="j-core" value="Core service: Java tests with Postgres ✱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="160" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="j-web" value="Mobile web: Expo checks and web build ✱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="j-landing" value="Landing page: build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="260" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="j-docker" value="Docker images: docker compose build ✱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="310" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="report" value="Test report&lt;br&gt;&lt;i&gt;table on the run page&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="1050" y="110" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="startcd" value="&lt;b&gt;Start CD&lt;/b&gt; (push only)&lt;br&gt;parts that changed&lt;br&gt;and passed their tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="1050" y="250" width="200" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="ci-note" value="✱ required to merge into main" style="text;html=1;fontSize=11;align=left;fontColor=#4a5a6a;" vertex="1" parent="1">
          <mxGeometry x="1050" y="195" width="200" height="20" as="geometry"/>
        </mxCell>

        <!-- CD band -->
        <mxCell id="band-cd" value="CD: cd.yml (deploys one tested commit)" style="rounded=1;arcSize=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fffaf3;strokeColor=#e07b24;fontStyle=1;fontSize=14;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="200" y="420" width="1140" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="cd-runner" value="Select runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="230" y="500" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;commit is on the branch,&lt;br&gt;its CI run passed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="420" y="492" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="refuse" value="Stop, nothing deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e1;strokeColor=#d9534f;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="430" y="610" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d-backend" value="&lt;b&gt;Deploy backend&lt;/b&gt;: AI, then Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="680" y="450" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d-web" value="&lt;b&gt;Deploy mobile web&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="680" y="505" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d-landing" value="&lt;b&gt;Deploy landing page&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="env-note" value="staging deploys right away; main waits for approval of each production environment" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#4a5a6a;" vertex="1" parent="1">
          <mxGeometry x="680" y="612" width="300" height="40" as="geometry"/>
        </mxCell>

        <!-- Preview band -->
        <mxCell id="band-prev" value="Preview: preview.yml (on demand, one pull request)" style="rounded=1;arcSize=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fbf8ff;strokeColor=#8a63d2;fontStyle=1;fontSize=14;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="1140" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p-check" value="&lt;b&gt;Check pull request&lt;/b&gt;&lt;br&gt;open, not from a fork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="420" y="760" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p-web" value="Mobile web preview&lt;br&gt;&lt;i&gt;smart-ledger-preview-0&amp;lt;PR % 10&amp;gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="680" y="740" width="290" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p-landing" value="Landing page preview&lt;br&gt;&lt;i&gt;smart-ledger-landing-pr-&amp;lt;PR&amp;gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="680" y="796" width="290" height="44" as="geometry"/>
        </mxCell>

        <!-- Targets column -->
        <mxCell id="tg-railway" value="&lt;b&gt;Railway&lt;/b&gt;&lt;br&gt;ai and core services&lt;br&gt;staging, production" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="1380" y="440" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="tg-vercel" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;mobile web, landing page&lt;br&gt;staging, production, preview" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="1380" y="560" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges: CI -->
        <mxCell id="e-pr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="t-pr" target="ci-runner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="t-push" target="ci-runner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;" edge="1" parent="1" source="ci-runner" target="changes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="changes" target="grp-test"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="grp-test" target="report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="grp-test" target="startcd"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: CI to CD -->
        <mxCell id="e-dispatch" value="workflow_dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#e07b24;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#1f2d3d;exitX=0.5;exitY=1;entryX=0;entryY=0.25;" edge="1" parent="1" source="startcd" target="cd-runner">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="400"/><mxPoint x="190" y="400"/><mxPoint x="190" y="512"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-tcd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#7a7a7a;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="t-cd" target="cd-runner"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: CD -->
        <mxCell id="e-d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;" edge="1" parent="1" source="cd-runner" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-fail" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#d9534f;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="verify" target="refuse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#3c9d5d;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="verify" target="d-backend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="525"/><mxPoint x="640" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="e-d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#3c9d5d;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="verify" target="d-web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#3c9d5d;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="verify" target="d-landing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="525"/><mxPoint x="640" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d-backend" target="tg-railway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="d-web" target="tg-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="525"/><mxPoint x="1300" y="578"/></Array></mxGeometry></mxCell>
        <mxCell id="e-r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d-landing" target="tg-vercel"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: Preview -->
        <mxCell id="e-p0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#7a7a7a;dashed=1;" edge="1" parent="1" source="t-prev" target="p-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#3c9d5d;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p-check" target="p-web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="785"/><mxPoint x="640" y="762"/></Array></mxGeometry></mxCell>
        <mxCell id="e-p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#3c9d5d;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p-check" target="p-landing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="785"/><mxPoint x="640" y="818"/></Array></mxGeometry></mxCell>
        <mxCell id="e-p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p-web" target="tg-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="762"/></Array></mxGeometry></mxCell>
        <mxCell id="e-p4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=7;strokeColor=#5b6b7b;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p-landing" target="tg-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="818"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
