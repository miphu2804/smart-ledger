        <mxCell id="f_max" parent="band5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" value="F1 max&#xa;raw score, no max-normalize" vertex="1"><mxGeometry x="40" y="45" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="f_note" parent="band5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Max-normalizing would force every query's top-1 to exactly 1, which makes s1 constant and puts the gate's score floor out of reach. With one retriever, F1 is just Q-cos's own score in [0, 1]." vertex="1"><mxGeometry x="370" y="45" width="500" height="80" as="geometry"/></mxCell>
