        <mxCell id="q_note" parent="band3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Counts the query trigrams each document shares and keeps those reaching &#964;. Posting lists are walked, never intersected &#8212; that is what the AND-trigram control (Rx) does instead, and it collapses to 48.5% recall@3." vertex="1"><mxGeometry x="1000" y="160" width="500" height="70" as="geometry"/></mxCell>

        <mxCell id="band4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="4 &#183; Scoring &#8212; Q-cos (plan &#167;5.3)" vertex="1"><mxGeometry x="20" y="620" width="1520" height="190" as="geometry"/></mxCell>
        <mxCell id="s_tf" parent="band4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="query tf map&#xa;trigram &#8594; count" vertex="1"><mxGeometry x="40" y="50" width="210" height="80" as="geometry"/></mxCell>
