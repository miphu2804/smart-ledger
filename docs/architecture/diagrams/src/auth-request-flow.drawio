<mxfile host="Electron">
  <diagram name="Auth request flow" id="auth-request-flow">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="910" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" parent="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="0" y="0" width="1640" height="910" as="geometry"/></mxCell>
        <mxCell id="flow" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="Request flow: sign-in and one API call" vertex="1"><mxGeometry x="20" y="20" width="1600" height="520" as="geometry"/></mxCell>
        <mxCell id="user" parent="flow" style="shape=umlActor;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=6;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontSize=12;fontColor=#1f2d3d;" value="User&lt;br&gt;(browser)" vertex="1"><mxGeometry x="60" y="230" width="40" height="72" as="geometry"/></mxCell>
        <mxCell id="web" parent="flow" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," value="Mobile web on Vercel&lt;br&gt;(origin = page domain)" vertex="1"><mxGeometry x="290" y="60" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="fb" parent="flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#f5a623;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="Firebase Auth&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;project of the environment&lt;/span&gt;" vertex="1"><mxGeometry x="640" y="50" width="200" height="76" as="geometry"/></mxCell>
        <mxCell id="core" parent="flow" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," value="Core (Railway)" vertex="1"><mxGeometry x="712" y="300" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="ai" parent="flow" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," value="AI (Railway, private)" vertex="1"><mxGeometry x="1092" y="300" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="db" parent="flow" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#1f2d3d;labelBackgroundColor=none;image=data:image/svg+xml," value="Supabase PostgreSQL" vertex="1"><mxGeometry x="1412" y="300" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="note" parent="flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f0b429;fontColor=#1f2d3d;align=left;spacingLeft=10;fontSize=12;" value="&lt;b&gt;Two domain gates, one project match&lt;/b&gt;&lt;br&gt;Step 1: Firebase rejects a page domain missing from &lt;i&gt;Authorized domains&lt;/i&gt;.&lt;br&gt;Step 3: Core rejects an origin missing from &lt;i&gt;CORS_ALLOWED_ORIGINS&lt;/i&gt; (403).&lt;br&gt;Step 5: Core returns 401 when the token comes from another Firebase project." vertex="1"><mxGeometry x="960" y="50" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="e0" parent="1" source="user" target="web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#555555;strokeColor=#555555;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" value="0 Open the web" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="108"/></Array></mxGeometry></mxCell>
        <mxCell id="e1" parent="1" source="user" target="fb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#1f5fbf;strokeColor=#1f5fbf;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" value="1 Sign in (OTP or email)" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="266"/><mxPoint x="470" y="127"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" parent="1" source="fb" target="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#1f5fbf;strokeColor=#1f5fbf;exitX=0.25;exitY=1;entryX=1;entryY=0.5;dashed=1;" value="2 ID token (JWT)" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="230"/><mxPoint x="520" y="230"/><mxPoint x="520" y="286"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" parent="1" source="user" target="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#c25e00;strokeColor=#c25e00;exitX=1;exitY=0.75;entryX=0;entryY=0.25;" value="3 CORS preflight (Origin header)" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="304"/><mxPoint x="480" y="334"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" parent="1" source="user" target="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#c25e00;strokeColor=#c25e00;exitX=0.5;exitY=1;entryX=0;entryY=0.75;" value="4 API call, Bearer ID token" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="410"/><mxPoint x="600" y="410"/><mxPoint x="600" y="362"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" parent="1" source="core" target="fb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2e7d32;strokeColor=#2e7d32;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" value="5 verifyIdToken (same project)" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="240"/><mxPoint x="810" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" parent="1" source="core" target="ai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#555555;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="6 Internal call (INTERNAL_API_TOKEN)" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" parent="1" source="ai" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#555555;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="7 Read" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" parent="1" source="core" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#555555;strokeColor=#555555;exitX=1;exitY=0.85;entryX=1;entryY=0.5;" value="7 Read / write" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="375"/><mxPoint x="840" y="470"/><mxPoint x="1530" y="470"/><mxPoint x="1530" y="348"/></Array></mxGeometry></mxCell>
        <mxCell id="envs" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="Environments: same flow, different domain and backends" vertex="1"><mxGeometry x="20" y="560" width="1600" height="330" as="geometry"/></mxCell>
        <mxCell id="env0" parent="envs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;Preview (pull request)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web: smart-ledger-preview-0N.vercel.app&lt;br&gt;N = last digit of the PR number&lt;br&gt;GitHub env: vercel-preview&lt;br&gt;Firebase: smart-ledger-c2892 (shared with staging)&lt;br&gt;Core: core-staging&lt;br&gt;DB: Supabase staging&lt;br&gt;Authorized domains + CORS: the 10 preview aliases" vertex="1"><mxGeometry x="30" y="50" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="env1" parent="envs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;Staging (push to staging)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web: smart-ledger-staging.vercel.app&lt;br&gt;&amp;nbsp;&lt;br&gt;GitHub env: vercel-staging&lt;br&gt;Firebase: smart-ledger-c2892&lt;br&gt;Core: core-staging&lt;br&gt;DB: Supabase staging&lt;br&gt;Authorized domains + CORS: staging domain" vertex="1"><mxGeometry x="550" y="50" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="env2" parent="envs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;Production (push to main, approved)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web: production domain (not configured)&lt;br&gt;&amp;nbsp;&lt;br&gt;GitHub env: vercel-production (empty)&lt;br&gt;Firebase: separate project (not created)&lt;br&gt;Core: core production&lt;br&gt;DB: Supabase production&lt;br&gt;Authorized domains + CORS: production domain" vertex="1"><mxGeometry x="1070" y="50" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="envnote" parent="envs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f0b429;fontColor=#1f2d3d;align=left;spacingLeft=10;fontSize=12;" value="Preview and staging share Firebase, Core and the database: data created on a preview shows on staging. Only the web build differs.&lt;br&gt;Core&#x27;s CORS_ALLOWED_ORIGINS is the Variable of GitHub environment railway-staging / railway-production, synced to Railway on deploy." vertex="1"><mxGeometry x="30" y="240" width="1540" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
