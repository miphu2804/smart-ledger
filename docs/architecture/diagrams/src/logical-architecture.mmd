flowchart LR
    mobile["Mobile app<br/>OWNER"]
    admin["Web dashboard<br/>ADMIN support"]

    subgraph core["Core · business capabilities"]
        direction TB
        access["Account / shop"]
        catalog["Catalog / stock"]
        sales["Sales &amp; refunds"]
        money["Expenses &amp; debt"]
        reports["Reports"]
        support["ADMIN support"]
        inbox["Notifications"]
    end

    ledger[("Business data<br/>Ledger and audit trail")]
    assistant["Bobi assistant<br/>Read-only"]

    subgraph external["External services"]
        direction TB
        auth["Firebase Auth<br/>Sign-in identity"]
        media["Cloudinary<br/>Media storage"]
        ga4["GA4<br/>Native opt-in"]
        models["Model providers<br/>Inference"]
        traces["HoneyHive<br/>AI tracing"]
    end

    mobile -->|business requests| core
    admin -->|audited support requests| core
    core -->|authoritative records| ledger
    core -->|verify identity| auth
    core -->|media operations| media
    core -->|chat proxy| assistant
    assistant --> models
    assistant -.->|when enabled| traces
    mobile -->|after consent only| ga4

    classDef capability fill:#ffffff,stroke:#64748b,color:#1f2937;
    classDef service fill:#ffffff,stroke:#64748b,color:#1f2937;
    class access,catalog,sales,money,reports,support,inbox capability;
    class mobile,admin,ledger,assistant,auth,media,ga4,models,traces service;
    style core fill:#f5f9ff,stroke:#60a5fa,color:#1d4ed8;
    style external fill:#f3f4f6,stroke:#9ca3af,color:#374151;
