  <diagram name="Secrets sync" id="secrets-sync">
    <mxGraphModel background="#ffffff" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" parent="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="0" y="0" width="1720" height="830" as="geometry"/></mxCell>

        <mxCell id="maint" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="Maintainer machine: change a secret (scripts/secrets/push.sh)" vertex="1"><mxGeometry x="20" y="20" width="1680" height="210" as="geometry"/></mxCell>
        <mxCell id="m_edit" parent="maint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;secrets/&amp;lt;env&amp;gt;/env/&lt;/b&gt;&lt;br&gt;plaintext .env.core, .env.ai, ...&lt;br&gt;edited by hand" vertex="1"><mxGeometry x="40" y="70" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="m_age" parent="maint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#5c4400;fontSize=12;" value="&lt;b&gt;age -R recipients.txt&lt;/b&gt;&lt;br&gt;encrypt each file for&lt;br&gt;every public key" vertex="1"><mxGeometry x="400" y="70" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="m_enc" parent="maint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;secrets/&amp;lt;env&amp;gt;/env.age/&lt;/b&gt;&lt;br&gt;ciphertext, git-ignored" vertex="1"><mxGeometry x="760" y="70" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="m_dvc" parent="maint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;dvc add + dvc push&lt;/b&gt;&lt;br&gt;writes env.age.dvc&lt;br&gt;(md5, size, remote)" vertex="1"><mxGeometry x="1120" y="70" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="m_commit" parent="maint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;git commit + push&lt;/b&gt;&lt;br&gt;env.age.dvc only&lt;br&gt;(secrets-guard hook)" vertex="1"><mxGeometry x="1430" y="70" width="210" height="90" as="geometry"/></mxCell>

        <mxCell id="store" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="Shared storage" vertex="1"><mxGeometry x="20" y="270" width="1680" height="190" as="geometry"/></mxCell>
        <mxCell id="r2" parent="store" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff1e6;strokeColor=#f38020;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;Cloudflare R2&lt;/b&gt;&lt;br&gt;smart-ledger-staging-creds&lt;br&gt;smart-ledger-production-creds&lt;br&gt;ciphertext only, every version kept" vertex="1"><mxGeometry x="1080" y="50" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="gh" parent="store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292f;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;GitHub repo&lt;/b&gt;&lt;br&gt;env.age.dvc (which version)&lt;br&gt;recipients.txt (public keys)&lt;br&gt;targets (files to copy out)&lt;br&gt;no secret, no ciphertext" vertex="1"><mxGeometry x="1430" y="50" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="note" parent="store" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;Who can read what&lt;/b&gt;&lt;br&gt;R2 token: download the ciphertext of one environment.&lt;br&gt;age private key listed in recipients.txt: decrypt it.&lt;br&gt;Both are needed; a leaked bucket alone exposes nothing.&lt;br&gt;Dev machines get staging only." vertex="1"><mxGeometry x="40" y="50" width="520" height="110" as="geometry"/></mxCell>

        <mxCell id="dev" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="Developer machine: get secrets (git pull, then scripts/secrets/apply.sh)" vertex="1"><mxGeometry x="20" y="500" width="1680" height="310" as="geometry"/></mxCell>
        <mxCell id="d_pull" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;git pull / checkout&lt;/b&gt;&lt;br&gt;post-merge hook runs&lt;br&gt;scripts/secrets/pull.sh" vertex="1"><mxGeometry x="1430" y="60" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="d_dvc" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;dvc pull&lt;/b&gt;&lt;br&gt;fetch env.age/ named by&lt;br&gt;the pointer (R2 token in&lt;br&gt;.dvc/config.local)" vertex="1"><mxGeometry x="1120" y="60" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="d_age" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#5c4400;fontSize=12;" value="&lt;b&gt;age -d -i age.key&lt;/b&gt;&lt;br&gt;~/.config/smartledger/age.key&lt;br&gt;decrypt every file" vertex="1"><mxGeometry x="760" y="60" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="d_env" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;secrets/staging/env/&lt;/b&gt;&lt;br&gt;rebuilt on every pull, mode 600&lt;br&gt;.env.core .env.ai .env.mobile&lt;br&gt;.env.railway.* github/ ..." vertex="1"><mxGeometry x="400" y="60" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="d_apply" parent="dev" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#5c4400;fontSize=11;" value="&lt;b&gt;apply.sh&lt;/b&gt;&lt;br&gt;listed in targets?&lt;br&gt;dry run, or --apply" vertex="1"><mxGeometry x="40" y="45" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d_targets" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;Copied out&lt;/b&gt; (old file kept as .bak)&lt;br&gt;backend/core/.env&lt;br&gt;backend/ai/.env&lt;br&gt;frontend/mobile/.env" vertex="1"><mxGeometry x="40" y="210" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="d_run" parent="dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="&lt;b&gt;docker compose&lt;/b&gt; / uvicorn / mvnw / Expo&lt;br&gt;read the copied files" vertex="1"><mxGeometry x="400" y="220" width="300" height="60" as="geometry"/></mxCell>
