        <mxCell id="in_voice" parent="band1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" value="Voice order&#xa;&#171;hai chai n&#432;&#7899;c m&#7855;m nam ng&#432;&#187;" vertex="1"><mxGeometry x="40" y="45" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="in_asr" parent="band1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;fontSize=12;" value="ASR transcript&#xa;(no token confidence exposed)" vertex="1"><mxGeometry x="320" y="45" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="in_parse" parent="band1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="parseOrder segmentation&#xa;span &#171;n&#432;&#7899;c m&#7855;m nam ng&#432;&#187; &#183; qty 2 &#183; unit &#171;chai&#187;" vertex="1"><mxGeometry x="590" y="45" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="in_q" parent="band1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;fontSize=12;" value="QueryLine" vertex="1"><mxGeometry x="940" y="45" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="in_note" parent="band1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Segmentation stays as shipped. The resolver replaces the matching step, not the split." vertex="1"><mxGeometry x="1140" y="45" width="340" height="70" as="geometry"/></mxCell>

        <mxCell id="band2" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="2 &#183; Normalization &#8212; N (plan &#167;5.1)" vertex="1"><mxGeometry x="20" y="190" width="1520" height="150" as="geometry"/></mxCell>
        <mxCell id="n_toned" parent="band2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="toned()&#xa;NFC &#183; lowercase &#183; punctuation&#8594;space" vertex="1"><mxGeometry x="40" y="50" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="n_folded" parent="band2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="folded()&#xa;strip diacritics &#183; &#273;&#8594;d" vertex="1"><mxGeometry x="400" y="50" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="n_space" parent="band2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="spaceRemovedFold()" vertex="1"><mxGeometry x="700" y="50" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="n_ex" parent="band2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="&#171;n&#432;&#7899;c m&#7855;m nam ng&#432;&#187;&#xa;&#8594; nuoc mam nam ngu &#8594; nuocmamnamngu" vertex="1"><mxGeometry x="940" y="50" width="500" height="75" as="geometry"/></mxCell>

        <mxCell id="band3" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="3 &#183; Candidate generation &#8212; Q trigram index (plan &#167;5.3)" vertex="1"><mxGeometry x="20" y="360" width="1520" height="300" as="geometry"/></mxCell>
        <mxCell id="q_pad" parent="band3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="paddedTrigrams()&#xa;## + s + #, q = 3" vertex="1"><mxGeometry x="40" y="70" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="q_filter" parent="band3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#1f2d3d;fontSize=12;" value="Ukkonen count filter&#xa;&#964; = max(|q|,|d|) &#8722; q + 1 &#8722; qK, K = 2&#xa;lossless for edit distance &#8804; K" vertex="1"><mxGeometry x="330" y="60" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="q_out" parent="band3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" value="candidate docIds&#xa;1 candidate for this span" vertex="1"><mxGeometry x="730" y="70" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="q_index" parent="band3" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;" value="Trigram index&#xa;t &#8594; docId[] &#183; df(t)" vertex="1"><mxGeometry x="1240" y="65" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="q_note" parent="band3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Q is the cheap filter in front of the expensive scorers. Its count filter is lossy above K = 2 edits, and a short spoken span against a longer catalog name is where that bites: &#171;m&#236; h&#7843;o h&#7843;o&#187; gets no candidate out of Q at all, and the row then rests on B alone." vertex="1"><mxGeometry x="40" y="215" width="1180" height="70" as="geometry"/></mxCell>

        <mxCell id="band4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="4 &#183; Scoring &#8212; two retrievers, independently (plan &#167;5.3, &#167;5.4)" vertex="1"><mxGeometry x="20" y="680" width="1520" height="270" as="geometry"/></mxCell>
        <mxCell id="s_q" parent="band4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="Q-bm25 &#8212; IDF-weighted trigram BM25&#xa;103  N&#432;&#7899;c m&#7855;m Nam Ng&#432; 500ml   score 29.398   rank 1&#xa;the only candidate the filter kept" vertex="1"><mxGeometry x="40" y="50" width="640" height="130" as="geometry"/></mxCell>
        <mxCell id="s_b" parent="band4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="B &#8212; syllable BM25&#xa;103  9.770 r1 &#183; 104  4.433 r2 &#183; 105  1.811 r3&#xa;119  1.811 r4 &#183; 126  1.649 r5" vertex="1"><mxGeometry x="720" y="50" width="640" height="130" as="geometry"/></mxCell>
        <mxCell id="s_note" parent="band4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="The two scores share no scale: 29.4 against 9.8 is not a ranking. R4 never adds them, which is exactly why RRF is the fusion it uses." vertex="1"><mxGeometry x="40" y="195" width="1320" height="60" as="geometry"/></mxCell>

        <mxCell id="band5" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="5 &#183; Fusion &#8212; RRF, k = 60 (plan &#167;5.5)" vertex="1"><mxGeometry x="20" y="970" width="1520" height="200" as="geometry"/></mxCell>
        <mxCell id="f_formula" parent="band5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;fontSize=12;" value="fused(d) = &#931; over retrievers  1 / (60 + rank(d))&#xa;rank-only, so no score normalisation is needed" vertex="1"><mxGeometry x="40" y="45" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="f_103" parent="band5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="103  N&#432;&#7899;c m&#7855;m Nam Ng&#432; 500ml&#xa;1/61 + 1/61 = 0.032787   &#8592; s1" vertex="1"><mxGeometry x="470" y="45" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="f_104" parent="band5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;fontColor=#1f2d3d;fontSize=12;" value="104  N&#432;&#7899;c m&#7855;m Chinsu 500ml&#xa;1/62 = 0.016129   &#8592; s2" vertex="1"><mxGeometry x="970" y="45" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="f_note" parent="band5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="topK = 5 kept, plus the gate features. 103 is rank 1 in both lists, so its fused score is exactly double 104's single 1/62." vertex="1"><mxGeometry x="40" y="150" width="1330" height="45" as="geometry"/></mxCell>

        <mxCell id="band6" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="6 &#183; Gate features (plan &#167;5.6)" vertex="1"><mxGeometry x="20" y="1190" width="1520" height="170" as="geometry"/></mxCell>
        <mxCell id="t_feat" parent="band6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;" value="s1 0.032787 &#183; s2 0.016129 &#183; margin 0.016658&#xa;disp 0.006818 &#183; agree 1 &#183; jacc 1&#xa;unit_ok unknown &#183; alias 0 &#183; len_q 4 &#183; stt_conf null" vertex="1"><mxGeometry x="40" y="50" width="700" height="90" as="geometry"/></mxCell>
        <mxCell id="t_note" parent="band6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="unit_ok is unknown on every dataset line, so the unit rule never fires in the bake-off. The app's catalog projection drops unit as well, so this is the app's number too until that is fixed." vertex="1"><mxGeometry x="770" y="50" width="700" height="90" as="geometry"/></mxCell>

        <mxCell id="band7" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="7 &#183; Gate G1 &#8212; rule chain, thresholds tuned on calibration (plan &#167;5.6)" vertex="1"><mxGeometry x="20" y="1380" width="1520" height="460" as="geometry"/></mxCell>
        <mxCell id="g_alias" parent="band7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;fontSize=12;" value="trusted alias&#xa;matches top-1?" vertex="1"><mxGeometry x="60" y="70" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g_floor" parent="band7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#1f2d3d;fontSize=12;" value="s1 &#60; sFloor?" vertex="1"><mxGeometry x="330" y="70" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="g_auto" parent="band7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#1f2d3d;fontSize=12;" value="s1 &#8805; sAuto &#8743;&#xa;margin &#8805; mMin &#8743;&#xa;agree = 1 &#8743;&#xa;unit_ok &#8800; mismatch?" vertex="1"><mxGeometry x="590" y="60" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="g_out_new" parent="band7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e1;strokeColor=#d9534f;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="NEW" vertex="1"><mxGeometry x="350" y="250" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="g_out_ask" parent="band7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#d4a017;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="ASK" vertex="1"><mxGeometry x="610" y="250" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="g_out_auto" parent="band7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="AUTO" vertex="1"><mxGeometry x="860" y="250" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="g_thresh" parent="band7" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="sFloor = sAuto = 0.032787&#xa;mMin = 0.001257 &#183; farMax = 1%&#xa;The floor is exactly this span's 2/61, so the test is an equality." vertex="1"><mxGeometry x="1120" y="60" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="g_order" parent="band7" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Tuned on the calibration split only, minimising unanswered lines: an ask anywhere, plus a refusal on a line whose item is in the catalog. A refusal on an out-of-catalog line is free, which is what stops the search spending its budget there." vertex="1"><mxGeometry x="1120" y="250" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="g_trace" parent="band7" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#1f2d3d;fontSize=11;" value="Path taken by this span:  alias? no  &#8594;  s1 &#60; sFloor? no, the score sits exactly on the floor  &#8594;  all four auto tests pass  &#8594;  AUTO." vertex="1"><mxGeometry x="60" y="350" width="1000" height="60" as="geometry"/></mxCell>

        <mxCell id="band8" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="8 &#183; Outcome and the alias loop (plan &#167;5.7)" vertex="1"><mxGeometry x="20" y="1860" width="1520" height="200" as="geometry"/></mxCell>
        <mxCell id="o_auto" parent="band8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;" value="AUTO&#xa;103 &#183; N&#432;&#7899;c m&#7855;m Nam Ng&#432; 500ml &#183; qty 2" vertex="1"><mxGeometry x="60" y="45" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="o_draft" parent="band8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#e07b24;fontColor=#1f2d3d;fontSize=12;" value="LineItem &#8594; app.setDraft()&#xa;&#8594; checkout &#8594; Core /sale-drafts + /confirm" vertex="1"><mxGeometry x="440" y="45" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="fb_alias" parent="band8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6ff;strokeColor=#8a63d2;fontColor=#1f2d3d;fontSize=12;" value="upsertAlias() on an ASK correction&#xa;confirm &#8594; +1 &#183; trusted at 2&#xa;index the corrected phrase as a doc" vertex="1"><mxGeometry x="880" y="45" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="o_note" parent="band8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="R4 asks on 43.6% of held-out lines, so the AUTO branch above is the minority case, not the typical one." vertex="1"><mxGeometry x="60" y="145" width="1200" height="45" as="geometry"/></mxCell>

        <mxCell id="band9" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#7a7a7a;fontColor=#1f2d3d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;pointerEvents=0;" value="9 &#183; Why the fusion carries the row &#8212; the same span through each retriever alone" vertex="1"><mxGeometry x="20" y="2080" width="1520" height="230" as="geometry"/></mxCell>
        <mxCell id="x_qonly" parent="band9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e1;strokeColor=#d9534f;fontColor=#1f2d3d;fontSize=12;" value="Q-bm25 alone&#xa;s1 = 1/61 = 0.016393 &#60; 0.032787&#xa;&#8594; NEW, refusing a correct match" vertex="1"><mxGeometry x="60" y="50" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="x_bonly" parent="band9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e1;strokeColor=#d9534f;fontColor=#1f2d3d;fontSize=12;" value="B alone&#xa;s1 = 1/61 = 0.016393 &#60; 0.032787&#xa;&#8594; NEW, the same way" vertex="1"><mxGeometry x="540" y="50" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="x_both" parent="band9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff5e3;strokeColor=#3c9d5d;fontColor=#1f2d3d;fontSize=12;fontStyle=1;" value="Q + B, RRF&#xa;s1 = 2/61 = 0.032787 = sFloor&#xa;&#8594; AUTO" vertex="1"><mxGeometry x="1020" y="50" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="x_note" parent="band9" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Neither retriever clears the tuned floor on this span by itself; only their agreement does. On the held-out split R4 reaches 95.6% recall@3 at 0.5% false-auto (95% CI 0.2&#8211;0.9%), against 49.4% for the shipped parseOrder matcher." vertex="1"><mxGeometry x="60" y="175" width="1400" height="45" as="geometry"/></mxCell>

        <mxCell id="z_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#5a6675;fontSize=11;" value="Traced by resolving &#171;hai chai n&#432;&#7899;c m&#7855;m nam ng&#432;&#187; through R4's config against the 30-item tap_hoa catalog, with the gate rules tuned in eval/reports/bakeoff_v3_lockbox2.md, which also supplies the held-out figures. 69% of that report's held-out lines were held out in bakeoff_v1 and bakeoff_v2 as well, so read them as a re-measurement on a re-drawn partition rather than as independent confirmation." vertex="1"><mxGeometry x="40" y="2330" width="1500" height="80" as="geometry"/></mxCell>

        <mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endSize=7;strokeColor=#5b8def;fontColor=#1f2d3d;" edge="1" source="in_voice" target="in_asr"><mxGeometry relative="1" as="geometry"/></mxCell>
