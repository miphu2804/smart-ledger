        <mxCell id="e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endSize=7;strokeColor=#5b8def;fontColor=#1f2d3d;" edge="1" source="in_parse" target="in_q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endSize=7;strokeColor=#5b8def;fontColor=#1f2d3d;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="in_q" target="n_toned"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endSize=7;strokeColor=#5b8def;fontColor=#1f2d3d;" edge="1" source="n_toned" target="n_folded"><mxGeometry relative="1" as="geometry"/></mxCell>
