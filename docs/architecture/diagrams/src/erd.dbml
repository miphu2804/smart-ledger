// =====================================================
// SMART LEDGER — PHASE 1 ERD
// =====================================================
//
// ID: BIGINT IDENTITY → Java Long
// Money: BIGINT VND
// Time: TIMESTAMPTZ, UTC internally; Core JSON displays +07:00
// Core schema: Flyway V1-V15 (business tables, idempotency, shared OWNER/ADMIN audit_logs, cost snapshot, media outbox and upload leases).
// Core audit alignment: staging b1de421c461d, 2026-10-06; AI sections re-checked at staging f1a4818, 2026-10-16.
// AI schema: supabase/migrations AI baseline (chat_conversations, chat_messages, vector extension, ai_read views, ai_sql_reader role),
// ledger views (v_debts, v_payments, v_expenses) and agent memory (agent_memories, agent_memory_settings; ADR-0002, off by default).
// V15 implements OWNER notifications/thresholds on feat/app-notifications; ai_requests remains planned.
// CORE-015 #238: V17 on feat/zalo-login adds external Zalo identities and OAuth sessions; not shared-DB rollout.
// CORE-016 #276 on feat/zalo-android: native schema approved, NO migration yet; native defaults OFF.
// oauth_login_sessions below remains V17. Pending extension: client_type (WEB default/ANDROID),
// native_client_id, return_target_id, unique handoff_reference_hash and handoff_expires_at;
// conditional client_origin + channel-aware VERIFIED/expiry constraints. See erd-description.md.
// The native SQL fixture is disposable-test-only, never a rollout script or current production schema.
// Report periods use Asia/Ho_Chi_Minh; this logical ERD does not imply runtime completion.
// Quantity: NUMERIC(15,3)
//
// =====================================================


// =====================================================
// ENUMS
// =====================================================

Enum SystemRole {
  OWNER
  ADMIN
}

Enum UserStatus {
  ACTIVE
  DISABLED
}

Enum ShopStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

Enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

Enum SaleStatus {
  CONFIRMED
  VOIDED
}

Enum PaymentStatus {
  PAID
  DEBT
  PARTIAL
}

Enum PaymentType {
  INITIAL
  DEBT_REPAYMENT
}

Enum PaymentMethod {
  CASH
  TRANSFER
}

Enum DebtStatus {
  OPEN
  SETTLED
  VOIDED
}

Enum DraftStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  EXPIRED
}

Enum DraftSourceType {
  MANUAL
  AI_VOICE
}

Enum ExpenseStatus {
  ACTIVE
  ARCHIVED
}

Enum AiInputType {
  TEXT
  AUDIO
  IMAGE
}

Enum AiMode {
  SALE
  EXPENSE
  INSIGHT
  REPLENISHMENT
}

Enum AiRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

Enum ChatRole {
  USER
  ASSISTANT
}

Enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  SALE_VOIDED
  SHOP_INACTIVATED
  SHOP_REACTIVATED
}


// =====================================================
// AUTH & TENANCY
// =====================================================

Table users {
  id bigint [pk, increment]

  display_name varchar(150) [not null]
  email varchar(255)
  phone varchar(30)
  avatar_url varchar(1000)
  avatar_public_id varchar(500) [note: 'V13 internal Cloudinary authenticated asset reference; never returned directly']

  system_role SystemRole [not null, default: 'OWNER']
  status UserStatus [not null, default: 'ACTIVE']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email
    phone
    system_role
  }

  Note: 'No password_hash. Phone and Google authentication are handled by Firebase.'
}


Table auth_identities {
  id bigint [pk, increment]

  user_id bigint [not null, unique]

  provider varchar(30) [not null, default: 'FIREBASE']
  provider_subject varchar(255) [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'One application user maps to one Firebase account. provider_subject stores the Firebase UID. Phone and Google are linked sign-in methods under that account.'
}

// Firebase UID here is a logical reference, not an FK: mapping may precede the Core user/profile.
Table external_auth_identities {
  provider varchar(30) [not null, note: 'CHECK ZALO']
  provider_app_id varchar(100) [not null]
  provider_subject varchar(255) [not null]
  firebase_uid varchar(128) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, provider_app_id, provider_subject) [pk, name: 'pk_external_auth_identities']
  }
  Note: 'V17 durable app-scoped identity mapping. RLS enabled, no public policies/grants. No auto-merge/reassignment, no FK to users; never deleted by OAuth TTL cleanup.'
}

Table oauth_login_sessions {
  id uuid [pk]
  state_hash varchar(64) [not null, unique]
  browser_binding_hash varchar(64) [not null]
  purpose varchar(10) [not null, note: 'CHECK LOGIN or LINK']
  client_origin varchar(2048) [not null]
  client_request_id varchar(128) [not null]
  client_challenge varchar(64) [not null]
  verifier_ciphertext varchar(2048) [note: 'AES-GCM provider PKCE verifier; cleared on verification/failure']
  status varchar(20) [not null, note: 'PENDING, EXCHANGING, VERIFIED, CONSUMED, FAILED']
  provider_subject varchar(255)
  display_name varchar(255)
  proof_hash varchar(64) [unique]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  proof_expires_at timestamptz
  completed_at timestamptz
  provider_app_id varchar(100) [not null]

  indexes {
    expires_at [name: 'ix_oauth_login_sessions_expires_at']
  }
  Note: 'V17 transient OAuth data, not business ledger. RLS enabled, no public policies/grants. Expiry/proof lifecycle CHECKs in migration. Only hashes of state/binding/proof; no provider tokens. Cleanup deletes expired sessions only.'
}


Table shops {
  id bigint [pk, increment]
  owner_id bigint [not null]

  name varchar(200) [not null]
  industry varchar(100) [not null]
  phone varchar(30)
  address varchar(500)
  logo_url varchar(1000)
  logo_public_id varchar(500) [note: 'V13 internal Cloudinary public asset reference; never returned directly']

  status ShopStatus [not null, default: 'ACTIVE']
  archived_at timestamptz
  inactive_reason varchar(500)
  archived_reason varchar(500)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    owner_id
    status
  }

  Note: 'One OWNER can own multiple shops. One shop has one OWNER in Phase 1.'
}


// =====================================================
// CATALOG & SIMPLE STOCK
// =====================================================

Table categories {
  id bigint [pk, increment]
  shop_id bigint [not null]

  name varchar(150) [not null]
  status CatalogStatus [not null, default: 'ACTIVE']

  archived_at timestamptz
  archived_by_user_id bigint

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, status)
  }
}


Table products {
  id bigint [pk, increment]
  shop_id bigint [not null]
  category_id bigint

  name varchar(255) [not null]
  barcode varchar(100) [note: 'V16 exact, case-sensitive; unique only among ACTIVE non-null codes in the same shop. Archive releases the code without rewriting history.']
  image_url varchar(1000)
  image_public_id varchar(500) [note: 'V13 internal Cloudinary public asset reference; never returned directly']
  unit varchar(50) [not null]

  selling_price_vnd bigint [not null]
  cost_price_vnd bigint

  tracked boolean [not null, default: false]
  stock_quantity numeric(15,3)
  low_stock_threshold numeric(15,3) [note: 'V15 nullable, nonnegative; null disables LOW_STOCK, zero stock always OUT_OF_STOCK']

  status CatalogStatus [not null, default: 'ACTIVE']
  archived_at timestamptz
  archived_by_user_id bigint

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, status)
    category_id
    // DBML cannot encode a partial-index predicate. Do not export an unconditional UNIQUE here.
  }

  Note: 'V16 SQL enforces UNIQUE (shop_id, barcode) WHERE status = ACTIVE AND barcode IS NOT NULL via uq_products_shop_barcode_active. The predicate is intentionally described rather than misrepresented as unconditional DBML uniqueness; see erd-description.md Migration Alignment.'
}


// =====================================================
// CUSTOMERS
// =====================================================

Table customers {
  id bigint [pk, increment]
  shop_id bigint [not null]

  name varchar(150) [not null]
  normalized_phone varchar(30)

  status CatalogStatus [not null, default: 'ACTIVE']
  archived_at timestamptz
  archived_by_user_id bigint

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, normalized_phone)
    (shop_id, status)
  }

  Note: 'Name and phone are not unique. Use customer_id to share one debt history; do not automatically merge matching names/phones.'
}


// =====================================================
// SALE DRAFTS
// =====================================================

Table sale_drafts {
  id bigint [pk, increment]
  shop_id bigint [not null]
  created_by_user_id bigint [not null]
  customer_id bigint

  customer_name varchar(150)
  customer_phone varchar(30)

  discount_vnd bigint [not null, default: 0]
  estimated_total_vnd bigint [not null, default: 0]

  initial_paid_vnd bigint [not null, default: 0]
  initial_payment_method PaymentMethod

  source_type DraftSourceType [not null, default: 'MANUAL']
  source_ai_request_id bigint [note: 'Column and index exist in Flyway V4; no foreign key until ai_requests exists']

  status DraftStatus [not null, default: 'DRAFT']

  expires_at timestamptz [not null]
  expired_at timestamptz

  confirmed_sale_id bigint [unique]
  confirmed_at timestamptz
  cancelled_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, created_by_user_id, status, expires_at)
    source_ai_request_id
  }

  Note: 'Draft does not affect revenue, debt or stock until confirmation.'
}


Table sale_draft_items {
  id bigint [pk, increment]
  draft_id bigint [not null]
  product_id bigint

  raw_product_name varchar(255)
  product_name_snapshot varchar(255)
  unit_snapshot varchar(50)

  quantity numeric(15,3) [not null]
  unit_price_vnd bigint [not null]
  line_total_vnd bigint [not null]

  needs_review boolean [not null, default: false]
  confidence_score numeric(5,4)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    draft_id
    product_id
  }

  Note: 'Core accepts a same-shop catalog product or a custom item with product_id null, a non-blank name and unit. Custom items do not deduct product stock.'
}


// =====================================================
// CONFIRMED SALES
// =====================================================

Table sales {
  id bigint [pk, increment]
  shop_id bigint [not null]
  created_by_user_id bigint [not null]
  customer_id bigint

  customer_name_snapshot varchar(150)
  customer_phone_snapshot varchar(30)

  subtotal_vnd bigint [not null]
  discount_vnd bigint [not null, default: 0]
  total_vnd bigint [not null]
  paid_vnd bigint [not null, default: 0]

  sale_status SaleStatus [not null, default: 'CONFIRMED']
  payment_status PaymentStatus [not null]

  sold_at timestamptz [not null, default: `now()`]

  voided_at timestamptz
  voided_by_user_id bigint
  void_reason varchar(500)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, sold_at)
    (customer_id, sold_at)
    payment_status
    sale_status
  }

  Note: 'Confirmed DEBT/PARTIAL sales require customer_id and a matching debt. Void preserves paid_vnd and payment_status as collection history; remaining debt is cancelled separately, and refund records money actually returned.'
}


Table sale_items {
  id bigint [pk, increment]
  sale_id bigint [not null]
  product_id bigint
  stock_deducted boolean

  product_name_snapshot varchar(255) [not null]
  unit_snapshot varchar(50) [not null]

  quantity numeric(15,3) [not null]
  unit_price_vnd bigint [not null]
  line_total_vnd bigint [not null]
  estimated_cost_vnd bigint

  created_at timestamptz [not null, default: `now()`]

  indexes {
    sale_id
    product_id
  }

  Note: 'product_id is null for a custom item; name/unit snapshots remain required. stock_deducted is true only when stock was deducted at confirmation, false for custom/untracked items. Its NULL means unknown historical stock movement. estimated_cost_vnd is total snapshotted catalog cost for the line; NULL means unknown/custom/history before V12 and must not be replaced with current Product cost or a guessed fallback.'
}


// =====================================================
// DEBTS, PAYMENTS & REFUNDS
// =====================================================

Table sale_refunds {
  id bigint [pk, increment]
  sale_id bigint [not null, unique]

  amount_vnd bigint [not null]
  refund_method PaymentMethod [not null]
  transfer_reference varchar(255)

  refunded_by_user_id bigint [not null]
  refunded_at timestamptz [not null, default: `now()`]

  indexes {
    refunded_at
  }

  Note: 'V9: at most one full refund per sale, amount_vnd > 0. Refund is all collected money, including later repayments; cancelled unpaid debt is not a refund. A zero-paid void creates no refund row. No partial refunds.'
}


Table debts {
  id bigint [pk, increment]
  sale_id bigint [not null, unique]
  customer_id bigint [not null]

  original_vnd bigint [not null]
  outstanding_vnd bigint [not null]

  status DebtStatus [not null, default: 'OPEN']

  created_at timestamptz [not null, default: `now()`]
  settled_at timestamptz
  voided_at timestamptz
  cancelled_vnd bigint

  indexes {
    (customer_id, status)
    status
  }

  Note: 'V9 lifecycle: OPEN has outstanding > 0 and no settled/void audit; SETTLED has outstanding = 0 and settled_at, with voided_at/cancelled_vnd NULL. VOIDED has outstanding = 0, settled_at NULL, voided_at and 0 < cancelled_vnd <= original_vnd. Voiding a settled debt keeps SETTLED.'
}


Table payments {
  id bigint [pk, increment]
  sale_id bigint [not null]
  debt_id bigint

  amount_vnd bigint [not null]
  payment_method PaymentMethod [not null]
  type PaymentType [not null]

  transfer_reference varchar(255)

  received_by_user_id bigint [not null]
  received_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (sale_id, received_at)
    (debt_id, received_at)
  }
}


// =====================================================
// EXPENSES
// =====================================================

Table expenses {
  id bigint [pk, increment]
  shop_id bigint [not null]
  created_by_user_id bigint [not null]

  category varchar(150)
  description varchar(500)
  amount_vnd bigint [not null]

  payment_method PaymentMethod
  expense_at timestamptz [not null]

  // AI origin
  source_ai_request_id bigint [note: 'Column and index exist in Flyway V6; no foreign key until ai_requests exists']

  status ExpenseStatus [not null, default: 'ACTIVE']
  archived_at timestamptz
  archived_by_user_id bigint

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, expense_at)
    (shop_id, status)
    source_ai_request_id
  }
}


// =====================================================
// AI TRACE
// =====================================================

// Planned (target design): no migration creates ai_requests yet. Runtime traces go to Logfire.
Table ai_requests {
  id bigint [pk, increment]
  shop_id bigint [not null]
  user_id bigint [not null]

  input_type AiInputType [not null]
  mode AiMode [not null]
  status AiRequestStatus [not null, default: 'PENDING']

  model varchar(150)
  model_version varchar(150)

  input_object_key varchar(1000)
  result_json jsonb
  error_message varchar(1000)

  delete_input_after timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, user_id, created_at)
    (shop_id, status)
  }
}


// =====================================================
// CHAT HISTORY
// =====================================================

// Một conversation = một cuộc hội thoại riêng.
// Việc hiển thị "Today / Yesterday / Previous 7 days / Older"
// được xử lý bằng last_message_at ở FE.

Table chat_conversations {
  id bigint [pk, increment]

  user_id bigint [not null]
  shop_id bigint [not null]

  title varchar(255)

  summary text [note: 'Unused by code since the chat summary was removed; kept for rollback, dropped by a later migration']
  summary_through_message_id bigint [note: 'Unused by code; kept for rollback, dropped by a later migration. No FK by design']

  started_at timestamptz [not null, default: `now()`]
  last_message_at timestamptz [not null, default: `now()`]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, shop_id, last_message_at)
    shop_id
  }

  Note: 'A conversation is explicitly separated by creating a new chat, not by time.'
}


Table chat_messages {
  id bigint [pk, increment]

  conversation_id bigint [not null]

  role ChatRole [not null]
  content text [not null]

  // Link to AI processing when the message comes from AI
  ai_request_id bigint [note: 'Column and index exist in the AI baseline; no foreign key until ai_requests exists.']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
    ai_request_id
  }
}

// Agent long-term memory (ADR-0002): migrations 20261014000000_agent_memories.sql and
// 20261015000000_agent_memory_visibility.sql. Written only when AGENT_MEMORY_ENABLED is on (default off,
// awaiting PO approval). Row-level security is on with no policy, so Supabase API roles see no rows.
Table agent_memories {
  id bigint [pk, increment]

  shop_id bigint [not null]
  user_id bigint [not null]
  source_conversation_id bigint [not null, note: 'ON DELETE CASCADE: deleting a conversation deletes the memories it produced']

  memory_type varchar(16) [not null, note: 'preference | semantic | procedural | episodic']
  content text [not null]
  embedding "vector(384)" [not null, note: 'pgvector; HNSW index with vector_cosine_ops']
  importance "double precision" [not null, default: 0.5, note: 'CHECK 0..1']
  metadata jsonb [not null, default: '{}', note: 'Summary rows hold {"summarized_from": [replaced ids]}; the replaced rows are deleted']
  expires_at timestamptz

  last_used_at timestamptz
  use_count integer [not null, default: 0]
  superseded_by bigint [note: 'Newer memory that corrects this one; ON DELETE SET NULL']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, user_id)
    source_conversation_id
    superseded_by
    embedding [note: 'USING hnsw (embedding vector_cosine_ops)']
  }
}

Table agent_memory_settings {
  shop_id bigint [not null]
  user_id bigint [not null]

  memory_enabled boolean [not null, default: true, note: 'No row means on; off stops recall and writes, deletes nothing']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, user_id) [pk]
  }
}

// AI read layer (views, not tables): schema ai_read holds v_shop_profile, v_categories,
// v_products, v_sales and v_sale_items (baseline), and v_debts, v_payments and v_expenses
// (20261016000000_ai_read_ledger_views.sql; debts and payments are scoped through their sale,
// v_expenses keeps ACTIVE rows only). Each filters on smartledger.shop_id and exposes no shop_id.
// Role ai_sql_reader (NOLOGIN) has SELECT on those views only. The login behind AI_SQL_READER_URL
// is created outside the migration. The vector extension is enabled; agent_memories is the only
// table with an embedding column.


// =====================================================
// NOTIFICATIONS
// =====================================================

// V15 OWNER in-app inbox; no push/AI/debt reminder event in this release.
Table notification_events {
  id bigint [pk, increment]
  shop_id bigint [not null]
  type NotificationType [not null]
  title varchar(255) [not null]
  body varchar(1000) [not null]
  entity_type varchar(100) [not null]
  entity_id bigint [not null]
  data_json jsonb [note: 'Internal JSON object, not returned to clients']
  dedup_key varchar(255) [not null]
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, dedup_key) [unique, name: 'uq_notification_event_dedup']
    (shop_id, created_at, id) [name: 'idx_notification_shop_time']
  }

  Note: 'V15: type/target CHECK, positive target ID, status target equals shop ID. Only stock alerts may resolve. SQL partial UNIQUE uq_notification_open_stock on (shop_id, entity_type, entity_id) WHERE stock type AND resolved_at IS NULL (not expressible as a DBML index).'
}


// V15 one OWNER recipient per event; readAt is separate from resolution.
Table notification_recipients {
  id bigint [pk, increment]

  notification_event_id bigint [not null]
  user_id bigint [not null]

  read_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at, id) [name: 'idx_notification_recipient_time']
    (user_id, read_at) [name: 'idx_notification_recipient_read']
    (notification_event_id, user_id) [unique, name: 'uq_notification_recipient']
  }

  Note: 'V15: one row per recipient, user/event FKs; read_at >= created_at or NULL. First read timestamp is preserved by Core under row locks.'
}


// =====================================================
// API IDEMPOTENCY
// =====================================================

Table api_idempotency_keys {
  id bigint [pk, increment]

  shop_id bigint [not null]
  user_id bigint [not null]

  operation varchar(100) [not null]
  idempotency_key varchar(255) [not null]
  request_hash varchar(128) [not null]

  resource_type varchar(100)
  resource_id bigint

  response_status integer
  response_body jsonb

  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, operation, idempotency_key) [unique]
    expires_at
  }
}


// =====================================================
// AUDIT LOG
// =====================================================

Table media_upload_keys {
  id bigint [pk, increment]
  scope_key varchar(100) [not null, note: 'SHOP:<id> for Product/logo, USER:<id> for avatar']
  user_id bigint [not null]
  operation varchar(100) [not null]
  idempotency_key varchar(255) [not null]
  request_hash varchar(128) [not null]
  public_id varchar(500) [not null, note: 'Internal provider identifier']
  lease_token uuid [not null, note: 'Fences expired/reclaimed attempts']
  expires_at timestamptz [not null]
  response_body jsonb [note: 'NULL means PENDING; completed avatar snapshot has no signed URL']

  indexes {
    (scope_key, operation, idempotency_key) [unique]
    public_id
  }

  Note: 'V14 durable media upload reservation and replay. Independent of monetary V7 idempotency; user FK ON DELETE RESTRICT.'
}

Table media_cleanup_jobs {
  id bigint [pk, increment]
  public_id varchar(500) [not null, note: 'Internal Cloudinary identifier; no business FK by design']
  asset_type varchar(30) [not null, note: 'PRODUCT_IMAGE | SHOP_LOGO | USER_AVATAR']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | COMPLETED']
  attempt_count integer [not null, default: 0]
  next_attempt_at timestamptz [not null]
  last_error varchar(500)
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (status, next_attempt_at, id)
  }

  Note: 'V13 post-commit deletion outbox for replaced or removed provider assets. No FK lets a job survive after its owner field is cleared.'
}

Table audit_logs {
  id bigint [pk, increment]

  actor_user_id bigint [not null]
  actor_role varchar(20) [not null, note: 'OWNER or ADMIN; actor role snapshot, V10']
  shop_id bigint [note: 'Nullable only for supported ADMIN non-shop reads (V11) and USER_AVATAR_UPDATED (V13); business events require a shop']

  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id bigint [note: 'Positive target for business/detail events and avatar actor (V13); null for permitted ADMIN global/list reads (V11)']

  outcome varchar(20) [not null, note: 'SUCCESS only (V10)']
  reason varchar(500)
  request_id varchar(36) [not null, note: 'Server-generated lowercase UUID; format checked by V10']
  idempotency_key varchar(255)
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'JSON object; Core allowlists keys/types. ADMIN reads store only queryPresent/resultCount']

  old_data jsonb [note: 'Retained nullable legacy column; Core does not populate snapshots']
  new_data jsonb [note: 'Retained nullable legacy column; Core does not populate snapshots']

  ip_address varchar(64) [note: 'Retained nullable legacy column; Core does not capture IP headers']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, created_at, id)
    (entity_type, entity_id)
    actor_user_id
  }

  Note: 'V10/V11/V13 shared append-only table, no admin_access_logs. Actor/shop FKs use ON DELETE RESTRICT. DB checks constrain action/entity/target combinations, positive IDs, role, SUCCESS outcome, UUID request_id and metadata object; UPDATE/DELETE/TRUNCATE triggers reject mutation. V11 permits null shop/target only for whitelisted ADMIN reads; V13 permits USER_AVATAR_UPDATED only when entity_id equals actor_user_id and shop/reason/key are null. OWNER and ADMIN APIs expose different scoped projections; see ERD description migration alignment and API contract.'
}


// =====================================================
// RELATIONSHIPS
// =====================================================

// ---------- AUTH ----------

Ref: users.id - auth_identities.user_id
Ref: users.id < shops.owner_id


// ---------- CATALOG ----------

Ref: shops.id < categories.shop_id
Ref: users.id < categories.archived_by_user_id

Ref: shops.id < products.shop_id
Ref: categories.id < products.category_id
Ref: users.id < products.archived_by_user_id

Ref: shops.id < customers.shop_id
Ref: users.id < customers.archived_by_user_id


// ---------- SALE DRAFT ----------

Ref: shops.id < sale_drafts.shop_id
Ref: users.id < sale_drafts.created_by_user_id
Ref: customers.id < sale_drafts.customer_id
// Planned, add when ai_requests exists: Ref: ai_requests.id < sale_drafts.source_ai_request_id

Ref: sale_drafts.confirmed_sale_id - sales.id

Ref: sale_drafts.id < sale_draft_items.draft_id
Ref: products.id < sale_draft_items.product_id


// ---------- SALES ----------

Ref: shops.id < sales.shop_id
Ref: users.id < sales.created_by_user_id
Ref: users.id < sales.voided_by_user_id
Ref: customers.id < sales.customer_id

Ref: sales.id < sale_items.sale_id
Ref: products.id < sale_items.product_id


// ---------- DEBT & PAYMENT ----------

Ref: sales.id - debts.sale_id
Ref: customers.id < debts.customer_id

Ref: sales.id < payments.sale_id
Ref: debts.id < payments.debt_id
Ref: users.id < payments.received_by_user_id

Ref: sales.id - sale_refunds.sale_id
Ref: users.id < sale_refunds.refunded_by_user_id


// ---------- EXPENSE ----------

Ref: shops.id < expenses.shop_id
Ref: users.id < expenses.created_by_user_id
Ref: users.id < expenses.archived_by_user_id
// Planned, add when ai_requests exists: Ref: ai_requests.id < expenses.source_ai_request_id


// ---------- AI ----------

Ref: shops.id < ai_requests.shop_id
Ref: users.id < ai_requests.user_id


// ---------- CHAT ----------

Ref: users.id < chat_conversations.user_id
Ref: shops.id < chat_conversations.shop_id

Ref: chat_conversations.id < chat_messages.conversation_id
// Planned, add when ai_requests exists: Ref: ai_requests.id < chat_messages.ai_request_id

Ref: shops.id < agent_memories.shop_id [delete: restrict]
Ref: users.id < agent_memories.user_id [delete: restrict]
Ref: chat_conversations.id < agent_memories.source_conversation_id [delete: cascade]
Ref: agent_memories.id < agent_memories.superseded_by [delete: set null]
Ref: shops.id < agent_memory_settings.shop_id [delete: restrict]
Ref: users.id < agent_memory_settings.user_id [delete: restrict]


// ---------- NOTIFICATION ----------

Ref: shops.id < notification_events.shop_id
Ref: notification_events.id < notification_recipients.notification_event_id
Ref: users.id < notification_recipients.user_id


// ---------- IDEMPOTENCY ----------

Ref: shops.id < api_idempotency_keys.shop_id
Ref: users.id < api_idempotency_keys.user_id
Ref: users.id < media_upload_keys.user_id [delete: restrict]


// ---------- AUDIT ----------

Ref: users.id < audit_logs.actor_user_id
Ref: shops.id < audit_logs.shop_id


// =====================================================
// VISUAL GROUPS
// =====================================================

TableGroup auth_and_tenancy {
  users
  auth_identities
  shops
}

TableGroup catalog_and_customers {
  categories
  products
  customers
}

TableGroup drafts_and_sales {
  sale_drafts
  sale_draft_items
  sales
  sale_items
}

TableGroup payment_and_expense {
  debts
  payments
  sale_refunds
  expenses
}

TableGroup ai_and_chat {
  ai_requests
  chat_conversations
  chat_messages
  agent_memories
  agent_memory_settings
}

TableGroup notification {
  notification_events
  notification_recipients
}

TableGroup safety_and_audit {
  api_idempotency_keys
  media_upload_keys
  media_cleanup_jobs
  audit_logs
}
