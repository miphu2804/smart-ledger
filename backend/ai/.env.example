### Config ###
APP_TITLE=SmartLedger AI
SERVER__HOST=0.0.0.0
SERVER__PORT=8001
LOG__LEVEL=INFO

### Postgres ###
# Host URL when Postgres runs via `docker compose up postgres`.
# Compose overrides this to host `postgres` inside the ai container.
POSTGRES__URL=postgresql://smartledger:smartledger@localhost:5432/smartledger

### Redis ###
REDIS__URL=redis://localhost:6379/0

### Qdrant ###
QDRANT__URL=

### LiteLLM ###
LITELLM__URL=

### Langfuse ###
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
LANGFUSE__HOST=
