### Config ###
APP_TITLE=SmartLedger AI
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

# Shared credential with Core. Every /internal/v1 route returns 401 without it, and an
# empty value fails closed, so the service is unusable until Core sends the header.
INTERNAL_API_TOKEN=local-dev-internal-token

### Postgres ###
# Host URL when Postgres runs via `docker compose up postgres`.
# Compose overrides this to host `postgres` inside the ai container.
POSTGRES_URL=postgresql://smartledger:smartledger@localhost:5432/smartledger

# Read-only login that is a member of ai_sql_reader (migration 004); see README. Leave
# empty to run chat without the shop-data tool. Never reuse the POSTGRES_URL user here.
AI_SQL_READER_URL=
SQL_TIMEOUT_MS=3000
SQL_ROW_LIMIT=100

### Redis ###
REDIS_URL=redis://localhost:6379/0

### Qdrant ###
QDRANT_URL=

### Model provider ###
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
MODEL_TIMEOUT_SECONDS=20
MODEL_REASONING_EFFORT=high
OPENAI_API_KEY=

# Model for background chat summarization. Leave empty to reuse MODEL_NAME.
SUMMARY_MODEL_NAME=

# Point to a self-hosted LiteLLM proxy or another OpenAI-compatible endpoint if needed.
OPENAI_BASE_URL=

### LiteLLM ###
LITELLM_URL=

### Langfuse ###
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
