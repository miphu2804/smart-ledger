### Config ###
APP_TITLE=SmartLedger AI
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

### Postgres / Redis ###
# POSTGRES_URL and REDIS_URL live in the Git-ignored repo-root `.env.<env>`.
# Dev shares the staging databases; export them before running:
#   set -a && source ../../.env.staging && set +a

### Model provider ###
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
MODEL_TIMEOUT_SECONDS=20
OPENAI_API_KEY=

# Point to a self-hosted LiteLLM proxy or another OpenAI-compatible endpoint if needed.
OPENAI_BASE_URL=

### LiteLLM ###
LITELLM_URL=

### Langfuse ###
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
