### Server ###
APP_TITLE=SmartLedger AI
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

### Core ###
# Must match Core's INTERNAL_API_TOKEN; a blank value rejects every /internal/v1 route.
INTERNAL_API_TOKEN=local-dev-internal-token

### Supabase ###
# Application database (chat history, catalog); staging values come from .env.staging.
POSTGRES_URL=
POSTGRES_POOL_MAX_SIZE=2
AI_SQL_READER_URL=
SQL_POOL_MAX_SIZE=2
SQL_TIMEOUT_MS=3000
SQL_ROW_LIMIT=100

### Redis ###
# Connected at startup; no feature reads it yet. Staging values come from .env.staging.
REDIS_URL=

### Model ###
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-haiku-5-5
MODEL_FALLBACKS=[]
MODEL_TIMEOUT_SECONDS=20
MODEL_REASONING_EFFORT=medium
# OpenCode Go key; for OpenAI itself leave the base URL blank and use
# MODEL_PROVIDER=openai with an OpenAI model
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/inference/go/v1

### Agent ###
AGENT_MAX_INPUT_CHARS=2000
AGENT_MODEL_CALL_LIMIT=4
AGENT_TOOL_CALL_LIMIT=3
AGENT_TURN_TOKEN_LIMIT=200000
AGENT_TURN_TIMEOUT_SECONDS=35
AGENT_HISTORY_TURNS=30
# Long-term memory (ADR-0002): needs `uv sync --group memory` and both agent memory migrations
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_TYPES=preference,procedural,semantic
# sentence-transformers (local, needs the memory group) or cloudflare (Workers AI)
AGENT_MEMORY_EMBEDDING_PROVIDER=sentence-transformers
AGENT_MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Workers AI instead, with no local model:
# AGENT_MEMORY_EMBEDDING_PROVIDER=cloudflare
# AGENT_MEMORY_EMBEDDING_MODEL=@cf/google/embeddinggemma-300m

### Calculation ###
# Arithmetic tool for the agent (src/calculation/); defaults are provisional,
# awaiting PO sign-off.
CALC_ENABLED=true
CALC_MAX_OPERATIONS=20
CALC_MAX_OPERAND_VALUE=1e15

### Sandbox ###
# Code Mode (src/sandbox/wrapper.py): the model runs model-written code in a Monty
# sandbox, but only when it writes a run_code snippet. Needs the `codemode` extra
# of pydantic-ai-harness; without it the sandbox stays off. The memory value is the
# Monty heap limit (exceeding it is a retry for the model), not process RAM.
SANDBOX_ENABLED=true
SANDBOX_MAX_MEMORY_BYTES=67108864
SANDBOX_MAX_DURATION_SECS=5
SANDBOX_MAX_TOOL_CALLS=25
SANDBOX_MAX_SUSPENSIONS=1000

### Cloudflare Workers AI ###
# Read by AGENT_MEMORY_EMBEDDING_PROVIDER=cloudflare; the token needs Workers AI Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

### Logfire ###
# Write token of the Logfire project; blank sends no traces. Traces carry no
# message content.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=

### Planned integrations (no feature reads these yet) ###
QDRANT_URL=
LITELLM_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
