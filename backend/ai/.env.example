### Config ###
APP_TITLE=SmartLedger AI
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

# Shared credential with Core. Every /internal/v1 route returns 401 without it, and an
# empty value fails closed, so the service is unusable until Core sends the header.
INTERNAL_API_TOKEN=local-dev-internal-token

### Postgres / Redis ###
# POSTGRES_URL and REDIS_URL live in the Git-ignored repo-root `.env.<env>`.
# Dev shares the staging databases; export them before running:
#   set -a && source ../../.env.staging && set +a
# Most connections the chat-history pool opens. Supabase's session pooler allows 15
# clients in all and Core's Hikari pool takes up to 10 by default, so keep this small.
POSTGRES_POOL_MAX_SIZE=2

# Read-only login that is a member of ai_sql_reader (migration 004); see README. Leave
# empty to run chat without the shop-data tool. Never reuse the POSTGRES_URL user here.
AI_SQL_READER_URL=
SQL_TIMEOUT_MS=3000
SQL_ROW_LIMIT=100

### Model provider ###
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
MODEL_TIMEOUT_SECONDS=20
MODEL_REASONING_EFFORT=high
OPENAI_API_KEY=

# Agent guardrails per chat turn: longest owner message read, model calls, tool calls.
AGENT_MAX_INPUT_CHARS=2000
AGENT_MODEL_CALL_LIMIT=4
AGENT_TOOL_CALL_LIMIT=3
AGENT_TURN_TOKEN_LIMIT=200000
AGENT_TURN_TIMEOUT_SECONDS=35

# Most recent owner/assistant exchanges sent to the model with each turn.
AGENT_HISTORY_TURNS=100

# Point to a self-hosted LiteLLM proxy or another OpenAI-compatible endpoint if needed.
OPENAI_BASE_URL=

### Planned integrations (no feature reads these yet) ###
QDRANT_URL=
LITELLM_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
