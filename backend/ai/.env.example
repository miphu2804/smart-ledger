### Config ###
APP_TITLE=SmartLedger AI
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

### Postgres ###
# Host URL when Postgres runs via `docker compose up postgres`.
# Compose overrides this to host `postgres` inside the ai container.
POSTGRES_URL=postgresql://smartledger:smartledger@localhost:5432/smartledger

### Redis ###
REDIS_URL=redis://localhost:6379/0

### Qdrant ###
QDRANT_URL=

### Model provider ###
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
MODEL_TIMEOUT_SECONDS=20
OPENAI_API_KEY=

# Point to a self-hosted LiteLLM proxy or another OpenAI-compatible endpoint if needed.
OPENAI_BASE_URL=

### LiteLLM ###
LITELLM_URL=

### Langfuse ###
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
