# Core: run scripts/secrets/apply.sh staging dev to write .env, or copy this file to .env and fill in the values

### Server ###
SERVER_PORT=
CORS_ALLOWED_ORIGINS=
OPENAPI_ENABLED=
SWAGGER_UI_ENABLED=

### Database ###
# The commented keys are set by the VPS env file only.
DATABASE_HOST=
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# POSTGRES_URL=
FLYWAY_ENABLED=
SPRING_JPA_HIBERNATE_DDL_AUTO=
# Supabase's session pooler takes 15 clients per environment: Core 8, AI 4 and Grafana 1 leave 2 spare.
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=8
# Keep 2 open while idle and fail a request after 5 s without a free connection instead of Hikari's 30 s.
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
# SPRING_JPA_OPEN_IN_VIEW=

### JVM ###
# Set by the VPS env file only; a dev machine uses the JVM defaults, so these stay commented out.
# JAVA_TOOL_OPTIONS=
# MALLOC_ARENA_MAX=
# SPRING_THREADS_VIRTUAL_ENABLED=

### Firebase ###
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_EMULATOR_HOST=

### AI service ###
AI_BASE_URL=
INTERNAL_API_TOKEN=

### Cloudinary ###
CLOUDINARY_ENABLED=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PUBLIC_ID_PREFIX=
CLOUDINARY_CLEANUP_FIXED_DELAY_MS=
MEDIA_UPLOAD_LEASE_SECONDS=

### Zalo ###
ZALO_ENABLED=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_CALLBACK_URL=
ZALO_CLIENT_ORIGINS=
ZALO_SESSION_ENCRYPTION_KEY=
ZALO_SESSION_TTL_SECONDS=
ZALO_PROOF_TTL_SECONDS=
ZALO_HTTP_TIMEOUT_SECONDS=

### Zalo native ###
ZALO_NATIVE_ENABLED=
ZALO_NATIVE_CLIENT_ID=
ZALO_NATIVE_PACKAGE_NAME=
ZALO_NATIVE_CERTIFICATE_SHA256=
ZALO_NATIVE_RETURN_TARGET_ID=
ZALO_NATIVE_RETURN_URL=
ZALO_NATIVE_HANDOFF_TTL_SECONDS=

### User activity ###
USER_ACTIVITY_ENABLED=false
USER_ACTIVITY_CACHE_MAXIMUM_SIZE=10000

### User rate limits ###
# Enable only after merged V20 is applied and all Core writers are upgraded.
USER_RATE_LIMIT_ENABLED=false
