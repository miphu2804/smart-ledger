## Local Core configuration reference.
## Spring Boot does not load this file automatically; configure these values in
## IntelliJ Run Configuration, the shell, or Docker Compose.

SERVER_PORT=8080
# Hosted runtimes may supply PORT instead. SERVER_PORT takes precedence.
# Exact browser origins, comma-separated, no trailing slash or wildcard.
# Example for Expo web on this computer: http://localhost:8081,http://127.0.0.1:8081
# Empty = no cross-origin browser access. Native clients still require auth.
CORS_ALLOWED_ORIGINS=
# Keep both true for local/staging. Set both false on the production runtime.
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

DATABASE_URL=jdbc:postgresql://localhost:5432/smartledger
DATABASE_USERNAME=smartledger
DATABASE_PASSWORD=
# Use false against the shared dev/staging database. Migrate only from merged
# staging code, by the migration owner. Use true on a disposable test database.
FLYWAY_ENABLED=false

FIREBASE_PROJECT_ID=
# Local path when running Core directly. For Docker, this must be the path
# inside the container where a read-only secret is mounted.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosts that cannot mount a file (Railway): the whole service-account
# JSON as one value. When set, it takes precedence over GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Core-only Cloudinary credentials. Keep these server-side and uncommitted.
# When enabled, all four values are required. Prefix must be a relative path
# without leading/trailing slash or '..'; use a different prefix per runtime.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PUBLIC_ID_PREFIX=smartledger/local
# A PENDING Product/logo upload is retryable after this lease expires.
MEDIA_UPLOAD_LEASE_SECONDS=300
# Optional local-only cleanup cadence; production default is 60000 ms.
# CLOUDINARY_CLEANUP_FIXED_DELAY_MS=5000
