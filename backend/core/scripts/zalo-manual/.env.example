# Copy outside Git to a private .env file. No shared DB variables here.
# Exact public HTTPS origin forwarding ONLY to the manual gateway at 127.0.0.1:8792.
ZALO_MANUAL_ORIGIN=https://replace-with-your-test-tunnel.example
ZALO_APP_ID=3632655625730637557
ZALO_APP_SECRET=
ZALO_MANUAL_FIREBASE_CREDENTIALS=D:/path/outside-repo/firebase-dev-staging-service-account.json
# This allows real Firebase dev/staging authentication/user creation, not production.
ZALO_MANUAL_CONFIRM_FIREBASE_STAGING=true
