// Collects what the alerts and dashboards need, every 30 s: host CPU, memory and disk; container CPU, memory and start
// time; the health probes of each environment; Caddy's request metrics; and every container's logs.

prometheus.exporter.unix "host" {
  procfs_path     = "/host/proc"
  sysfs_path      = "/host/sys"
  rootfs_path     = "/host/root"
  set_collectors  = ["cpu", "meminfo", "filesystem", "loadavg"]

  // Docker volumes and overlays would add a series per mount; the disk alert reads only "/".
  filesystem {
    mount_points_exclude = "^/(dev|proc|run|sys|mnt|var/lib/docker)($|/)"
  }
}

prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "2m"
  enabled_metrics  = ["cpu", "memory"]
}

// targets/<environment>.json holds that environment's public Core liveness and readiness URLs, which go through DNS,
// Caddy, the certificate and Core like a user's request, and its AI and Bifrost health URLs on the app network,
// each with `env` and `check` labels.
discovery.file "probes" {
  files = ["/etc/alloy/targets/*.json"]
}

discovery.relabel "probes" {
  targets = discovery.file.probes.targets

  rule {
    source_labels = ["__address__"]
    target_label  = "address"
  }

  // Probe names must be unique, and each environment has two probes.
  rule {
    source_labels = ["env", "check"]
    separator     = "-"
    target_label  = "name"
  }

  rule {
    target_label = "module"
    replacement  = "http_2xx"
  }

  // The probed host ties Caddy's per-host request metrics to their environment (prometheus/rules/service-red.yml).
  rule {
    source_labels = ["__address__"]
    regex         = "https?://([^/:]+).*"
    target_label  = "host"
  }
}

prometheus.exporter.blackbox "probes" {
  config  = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"
  targets = discovery.relabel.probes.output
}

// The shared Caddy's request metrics on the edge network (deploy/edge/Caddyfile), by container name like the probes.
discovery.relabel "caddy" {
  targets = [{ "__address__" = "smart-ledger-edge-caddy-1:9180" }]

  rule {
    target_label = "job"
    replacement  = "caddy"
  }
}

// targets/services/<environment>.json lists the services that export their own /metrics on the app network, each
// with `env` and `service` labels; deploy/ansible/playbook.yml writes it.
discovery.file "services" {
  files = ["/etc/alloy/targets/services/*.json"]
}

prometheus.scrape "all" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.cadvisor.containers.targets, prometheus.exporter.blackbox.probes.targets, discovery.relabel.caddy.output, discovery.file.services.targets)
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Labels each log stream with its container, its Compose project and, for the app stacks, its environment.
discovery.relabel "logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "smart-ledger-(staging|production)"
    target_label  = "env"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
