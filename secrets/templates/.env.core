DATABASE_PASSWORD=
POSTGRES_URL=
FLYWAY_ENABLED=
# 8: Core, AI (4) and Grafana (1) share the 15-client session pooler.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=
# 2 idle and 5000 ms: idle Core holds 2 pooler slots, and a saturated pool fails fast like AI's 5 s checkout.
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=
SPRING_JPA_OPEN_IN_VIEW=

