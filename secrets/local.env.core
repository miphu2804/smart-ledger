# Core on a dev machine: the keys apply.sh staging dev puts over staging. The values are the public defaults of scripts/local-db.sh, not secrets.

### Database ###
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/smartledger
DATABASE_USERNAME=smartledger
DATABASE_PASSWORD=smartledger
DATABASE_HOST=127.0.0.1

### Dev machine ###
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true
FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
GOOGLE_APPLICATION_CREDENTIALS=/Users/miphu/.secrets/smart-ledger-c2892-firebase-adminsdk-fbsvc-294eda479a.json
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
AI_BASE_URL=http://localhost:8001
CLOUDINARY_PUBLIC_ID_PREFIX=smartledger/local
CLOUDINARY_CLEANUP_FIXED_DELAY_MS=5000
# Railway sizes the JVM for its small container; a dev machine uses the JVM defaults.
JAVA_TOOL_OPTIONS=
MALLOC_ARENA_MAX=
