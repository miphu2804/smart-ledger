# Load-test settings for one target environment. Copy to .env.staging or
# .env.production (git-ignored) and run with:
#   uv run --env-file .env.staging locust --headless --csv reports/smoke --html reports/smoke.html
# The same names are the loadtest-<env> GitHub Environment's variables and secrets,
# except LOCUST_HOST, which is LOADTEST_CORE_URL there; see README.md. Leave
# secrets blank here.

# Target; Locust reads LOCUST_HOST as --host
TARGET_ENV=staging
LOCUST_HOST=https://core-staging-01d2.up.railway.app
# Production only: must equal --host
LOADTEST_CONFIRM_HOST=

# Auth: Web API key of the target Firebase project (EXPO_PUBLIC_FIREBASE_API_KEY)
AUTH_MODE=firebase
FIREBASE_API_KEY=
ACCOUNTS_FILE=accounts.csv

# Shape
LOAD_PROFILE=smoke
PEAK_USERS=50
HOLD_SECONDS=

# Data-creating traffic (staging only)
LOADTEST_WRITES=0
CHAT_USERS=0
CHAT_MAX_REQUESTS=0

# Grafana Cloud push: stack Details -> Prometheus/InfluxDB; token needs metrics:write
GRAFANA_PUSH_URL=
GRAFANA_PUSH_USER=
GRAFANA_PUSH_TOKEN=

# Results
SUMMARY_FILE=reports/summary.json
