# Monitoring endpoints and the read-only database login Grafana uses. Copy to
# .env (git-ignored). probe.py reads the MONITOR_* names:
#   uv run --env-file .env probe.py
# They match the repository variables of synthetic-monitor.yml. The GRAFANA_PG_*
# names are not read by any script; they record what goes into Grafana's
# Postgres datasource form (docs/development/load-testing-and-monitoring.md).

MONITOR_STAGING_CORE_URL=https://core-staging-01d2.up.railway.app
MONITOR_STAGING_WEB_URL=https://smart-ledger-staging.vercel.app
MONITOR_PRODUCTION_CORE_URL=
MONITOR_PRODUCTION_WEB_URL=https://smart-ledger-prod.vercel.app

# Grafana Cloud stack
GRAFANA_STACK_URL=

# Supabase transaction pooler (port 6543), role grafana_reader
GRAFANA_PG_HOST=
GRAFANA_PG_PORT=6543
GRAFANA_PG_DATABASE=postgres
GRAFANA_PG_USER=
GRAFANA_PG_PASSWORD=
