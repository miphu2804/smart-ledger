    "CLOUDINARY_PUBLIC_ID_PREFIX": {
      "text": "Thiếu khi CLOUDINARY_ENABLED=true thì Core không khởi động: \"CLOUDINARY_PUBLIC_ID_PREFIX is required when CLOUDINARY_ENABLED=true\".",
      "source": "backend/core/src/main/java/com/smartledger/core/config/CloudinaryMediaConfiguration.java:30"
