  "symptoms": {
    "INTERNAL_API_TOKEN": {
      "text": "AI thiếu token thì mọi route /internal/v1 trả 401. Core và AI lệch nhau thì AI trả 401, Core log \"AI service answered 401\" và app nhận 503 ai_unavailable.",
      "source": "backend/ai/src/security.py:14, backend/core/src/main/java/com/smartledger/core/service/impl/AgentServiceImpl.java:177"
    },
    "AI_BASE_URL": {
      "text": "Core không gọi được AI: log \"AI service call failed\", app nhận 503 ai_unavailable.",
      "source": "backend/core/src/main/java/com/smartledger/core/service/impl/AgentServiceImpl.java:231"
    },
    "OPENAI_API_KEY": {
      "text": "Thiếu thì AI log \"model provider unconfigured\" và chat tắt, mọi lượt chat trả 503 ai_unavailable. Sai key thì lỗi từ gateway cũng thành 503 ai_unavailable, nguyên nhân nằm trong log AI.",
      "source": "backend/ai/src/providers/llm_factory.py:44, backend/ai/src/main.py:178"
    },
    "OPENAI_BASE_URL": {
      "text": "Sai URL thì mọi model call lỗi và AI trả 503 ai_unavailable; nguyên nhân nằm trong log AI.",
      "source": "backend/ai/src/main.py:224"
    },
    "POSTGRES_URL": {
      "text": "Database không tới được không làm AI dừng khởi động; request cần lịch sử chat trả 503 ai_unavailable.",
      "source": "backend/ai/src/infra/postgre_db_client.py:25"
    },
    "AI_SQL_READER_URL": {
      "text": "Thiếu thì AI log \"sql reader unconfigured; shop-data tool off\": chat vẫn chạy nhưng agent không đọc được dữ liệu tiệm.",
      "source": "backend/ai/src/main.py:51"
    },
    "LOGFIRE_TOKEN": {
      "text": "Thiếu thì AI log \"logfire unconfigured; traces off\" và không gửi trace; chat vẫn chạy.",
      "source": "backend/ai/src/observability.py:19"
    },
    "DATABASE_URL": {
      "text": "Core không khởi động được: Flyway chạy lúc start (FLYWAY_ENABLED mặc định true) và cần kết nối database.",
      "source": "backend/core/src/main/resources/application.yml:9"
    },
    "DATABASE_USERNAME": {
      "text": "Sai user thì Core không khởi động được vì Flyway không đăng nhập được database.",
      "source": "backend/core/src/main/resources/application.yml:9"
    },
    "DATABASE_PASSWORD": {
      "text": "Sai mật khẩu thì Core không khởi động được vì Flyway không đăng nhập được database.",
      "source": "backend/core/src/main/resources/application.yml:9"
    },
    "FIREBASE_SERVICE_ACCOUNT_JSON": {
      "text": "Trống thì Core tìm Application Default Credentials; trên VPS không có nên bean FirebaseApp lỗi và Core không khởi động. JSON hỏng cũng làm Core không khởi động.",
      "source": "backend/core/src/main/java/com/smartledger/core/config/FirebaseAdminConfiguration.java:35"
    },
    "FIREBASE_PROJECT_ID": {
      "text": "Không bắt buộc: thiếu thì Firebase lấy project từ service account. Lệch project với app thì Core từ chối ID token của app.",
      "source": "backend/core/src/main/java/com/smartledger/core/config/FirebaseAdminConfiguration.java:27"
    },
    "CLOUDINARY_ENABLED": {
      "text": "false thì mọi thao tác ảnh trả 503 media_unavailable. true mà thiếu CLOUDINARY_* thì Core không khởi động với lỗi \"... is required when CLOUDINARY_ENABLED=true\".",
      "source": "backend/core/src/main/java/com/smartledger/core/config/CloudinaryMediaConfiguration.java:25"
    },
    "CLOUDINARY_CLOUD_NAME": {
      "text": "Thiếu khi CLOUDINARY_ENABLED=true thì Core không khởi động: \"CLOUDINARY_CLOUD_NAME is required when CLOUDINARY_ENABLED=true\".",
      "source": "backend/core/src/main/java/com/smartledger/core/config/CloudinaryMediaConfiguration.java:27"
    },
    "CLOUDINARY_API_KEY": {
      "text": "Thiếu khi CLOUDINARY_ENABLED=true thì Core không khởi động: \"CLOUDINARY_API_KEY is required when CLOUDINARY_ENABLED=true\".",
