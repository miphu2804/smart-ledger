    },
    "ZALO_SESSION_ENCRYPTION_KEY": {
      "text": "Key hỏng hoặc thiếu thì ZaloCrypto không tạo được cipher và đăng nhập Zalo trả 503 zalo_unavailable.",
      "source": "backend/core/src/main/java/com/smartledger/core/zalo/ZaloCrypto.java:84"
    },
    "ZALO_APP_SECRET": {
      "text": "Sai thì Zalo từ chối đổi code lấy token và đăng nhập trả 503 zalo_provider_unavailable.",
