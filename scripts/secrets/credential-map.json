    },
    "GRAFANA_ADMIN_PASSWORD": {
      "text": "Thiếu khi MONITOR_DOMAIN có giá trị thì playbook dừng với \"... also needs GRAFANA_ADMIN_PASSWORD, MONITOR_DISCORD_WEBHOOK_URL, ...\"; compose của monitoring cũng từ chối chạy.",
      "source": "deploy/ansible/playbook.yml:351, deploy/monitoring/compose.yaml:84"
