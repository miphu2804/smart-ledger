    "CLOUDINARY_API_SECRET": {
      "text": "Thiếu khi CLOUDINARY_ENABLED=true thì Core không khởi động: \"CLOUDINARY_API_SECRET is required when CLOUDINARY_ENABLED=true\".",
      "source": "backend/core/src/main/java/com/smartledger/core/config/CloudinaryMediaConfiguration.java:29"
