    "MONITOR_TELEGRAM_BOT_TOKEN": {
      "text": "Thiếu khi MONITOR_DOMAIN có giá trị thì playbook dừng trước khi deploy monitoring.",
      "source": "deploy/ansible/playbook.yml:351"
