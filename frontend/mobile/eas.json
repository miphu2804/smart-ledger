{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "dev-client": {
      "extends": "development",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "phone-test": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_MOCK_CORE": "true",
        "EXPO_PUBLIC_MOCK_SHOPS": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
