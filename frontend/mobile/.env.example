# Mobile app: run scripts/secrets/apply.sh staging dev to write .env, or copy this file to .env and fill in the values

### API ###
EXPO_PUBLIC_API_ENDPOINT=

### Firebase ###
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=

### Mock data ###
EXPO_PUBLIC_USE_MOCK=
EXPO_PUBLIC_MOCK_CORE=
EXPO_PUBLIC_MOCK_SHOPS=

### Speech to text ###
EXPO_PUBLIC_STT_MODEL_URL=

### App updates ###
# Not set on staging.
EXPO_PUBLIC_UPDATE_URL=

### Facebook ###
# Not set on staging.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

### Support ###
