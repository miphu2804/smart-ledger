EXPO_PUBLIC_API_ENDPOINT=http://localhost:8000
EXPO_PUBLIC_USE_MOCK=true

# Firebase thật nhưng chưa chạy Core (/auth/session, /me, /shops giả lập): đặt USE_MOCK=false và MOCK_CORE=true
EXPO_PUBLIC_MOCK_CORE=false

# Core THẬT: USE_MOCK=false, MOCK_CORE=false, MOCK_SHOPS=false, và API_ENDPOINT trỏ tới Core:
#   - Core staging trên Railway (mặc định khi dev, không cần chạy backend trên máy):
#       EXPO_PUBLIC_API_ENDPOINT=https://core-staging-01d2.up.railway.app
#   - Core chạy trên máy (chỉ khi đang sửa backend): điện thoại thật dùng IP LAN, ví dụ http://192.168.1.10:8000;
#     máy ảo Android dùng http://10.0.2.2:8000
# MOCK_SHOPS=true chỉ giả lập riêng POST /shops (tiệm chỉ lưu trên máy).
EXPO_PUBLIC_MOCK_SHOPS=false

# Firebase (chỉ cần khi EXPO_PUBLIC_USE_MOCK=false) — lấy ở Firebase Console → Project settings → Your apps → Web app
# Android/iOS dùng google-services.json / GoogleService-Info.plist, không dùng các biến này
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Nhận dạng giọng nói trên Android: nơi app tải model về lần đầu (kết thúc bằng /). Xem assets/models/README.md
#   emulator: http://10.0.2.2:8090/   điện thoại thật: http://<IP máy tính>:8090/   (chạy `node scripts/serve-stt-model.js`)
EXPO_PUBLIC_STT_MODEL_URL=

# Đăng nhập Facebook (chỉ dùng lúc build/prebuild, KHÔNG có tiền tố EXPO_PUBLIC_ nên không vào bundle JS).
# App ID: Meta for Developers → Cài đặt ứng dụng → Cơ bản. Client Token: Cài đặt ứng dụng → Nâng cao → Bảo mật.
# KHÔNG đặt App Secret ở đây: nó chỉ dán vào Firebase Console. Xem README, mục "Đăng nhập Facebook".
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Email hỗ trợ hiện ở màn xác minh email (tuỳ chọn)
EXPO_PUBLIC_SUPPORT_EMAIL=
