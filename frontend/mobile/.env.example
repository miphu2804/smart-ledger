### Core API ###
EXPO_PUBLIC_API_ENDPOINT=https://core-staging-01d2.up.railway.app

### Mock ###
EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_MOCK_CORE=false
EXPO_PUBLIC_MOCK_SHOPS=false

### Firebase ###
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

### Speech ###
EXPO_PUBLIC_STT_MODEL_URL=

# Đăng nhập Facebook (chỉ dùng lúc build/prebuild, KHÔNG có tiền tố EXPO_PUBLIC_ nên không vào bundle JS).
# App ID: Meta for Developers → Cài đặt ứng dụng → Cơ bản. Client Token: Cài đặt ứng dụng → Nâng cao → Bảo mật.
# KHÔNG đặt App Secret ở đây: nó chỉ dán vào Firebase Console. Xem README, mục "Đăng nhập Facebook".
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Email hỗ trợ hiện ở màn xác minh email (tuỳ chọn)
EXPO_PUBLIC_SUPPORT_EMAIL=
