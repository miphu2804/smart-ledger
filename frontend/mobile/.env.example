EXPO_PUBLIC_API_ENDPOINT=http://localhost:8000
EXPO_PUBLIC_USE_MOCK=true

# Firebase thật nhưng Core chưa có API (/auth/session, /me, /shops giả lập): đặt USE_MOCK=false và MOCK_CORE=true
EXPO_PUBLIC_MOCK_CORE=false

# Core THẬT (nhánh feat/auth-session) đã có /auth/session và /me nhưng chưa có /shops:
#   USE_MOCK=false, MOCK_CORE=false, MOCK_SHOPS=true, và API_ENDPOINT trỏ tới máy chạy Core
#   (điện thoại thật: IP LAN của máy, ví dụ http://192.168.1.10:8000; máy ảo Android: http://10.0.2.2:8000)
EXPO_PUBLIC_MOCK_SHOPS=false

# Firebase (chỉ cần khi EXPO_PUBLIC_USE_MOCK=false) — lấy ở Firebase Console → Project settings → Your apps → Web app
# Android/iOS dùng google-services.json / GoogleService-Info.plist, không dùng các biến này
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
