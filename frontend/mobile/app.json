{
  "expo": {
    "name": "Sổ Nghe Lời",
    "slug": "so-nghe-loi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand-logo.png",
      "backgroundColor": "#F7F6F2",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.teamhexa.songheloi",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Sổ Nghe Lời cần quyền truy cập Camera để quét mã vạch sản phẩm và chụp ảnh hàng hoá.",
        "NSMicrophoneUsageDescription": "Sổ Nghe Lời cần quyền truy cập Microphone để tạo đơn hàng bằng giọng nói."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F2",
        "foregroundImage": "./assets/brand-logo.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "vn.teamhexa.songheloi",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/brand-logo.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["@react-native-firebase/app", { "ios": { "disableSPM": true } }],
      "@react-native-firebase/auth",
      ["expo-build-properties", { "ios": { "useFrameworks": "static", "usePrecompiledModules": false } }],
      [
        "expo-camera",
        {
          "cameraPermission": "Sổ Nghe Lời cần quyền truy cập Camera để quét mã vạch sản phẩm và chụp ảnh hàng hoá.",
          "microphonePermission": "Sổ Nghe Lời cần quyền truy cập Microphone để tạo đơn hàng bằng giọng nói."
        }
      ]
    ],
    "scheme": "songheloi",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d202d7d3-688d-4b70-93d9-584efd347b25"
      }
    }
  }
}
