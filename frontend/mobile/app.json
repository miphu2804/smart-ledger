{
  "expo": {
    "name": "Sổ Nghe Lời",
    "slug": "so-nghe-loi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.teamhexa.songheloi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2858D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.teamhexa.songheloi"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "songheloi",
    "experiments": {
      "typedRoutes": false
    }
  }
}