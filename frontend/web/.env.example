### Core API ###
# Core root without /api/v1 (local Core listens on 8080)
VITE_API_ENDPOINT=http://localhost:8080

### Landing page ###
# Liên kết tải APK Android; để trống thì trang giới thiệu không hiện nút tải
VITE_ANDROID_APK_URL=

### Legal pages ###
# Email liên hệ và kênh Facebook/TikTok/Instagram nằm trong site.yaml
VITE_LEGAL_DRAFT=true

### Admin dashboard (/admin) ###
# Off unless "true" at build time; the build without it has no admin code. Set true in .env.local to develop it.
VITE_ADMIN_ENABLED=false
# Mock data (default) or the real Core admin API ("false")
VITE_USE_MOCK=true
# Real mode signs in with Firebase email + password: the Web API key of the Firebase project Core verifies tokens against
VITE_FIREBASE_API_KEY=
# Optional, local only: Firebase Auth Emulator host (e.g. localhost:9099)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
