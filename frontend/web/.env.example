### Core API ###
VITE_API_ENDPOINT=http://localhost:8000

### Landing page ###
# Liên kết tải APK Android; để trống thì trang giới thiệu không hiện nút tải
VITE_ANDROID_APK_URL=

### Legal pages ###
VITE_CONTACT_EMAIL=
VITE_LEGAL_DRAFT=true

### Admin dashboard (/admin) ###
# Off unless "true" at build time; the build without it has no admin code. Set true in .env.local to develop it.
VITE_ADMIN_ENABLED=false
